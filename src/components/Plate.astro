---
/* Plate — the artwork for a project, drawn rather than photographed.
   One 216 × 100 drawing per slug, used at billboard size and at thumb size.
   Each plate is built from its own project's visual system: Poolside's
   water stops, PaperNotes' ruled sheet, Light's daylight arc. */
interface Props { slug: string; }
const { slug } = Astro.props;
---
<svg class="plate" viewBox="0 0 216 100" preserveAspectRatio="xMidYMid slice" role="img" aria-hidden="true">
  {slug === 'poolside' && (
    <g>
      <defs>
        <linearGradient id="pl-water" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#0E4C63" /><stop offset="0.55" stop-color="#12718C" /><stop offset="1" stop-color="#1FA0A8" />
        </linearGradient>
      </defs>
      <rect width="216" height="100" fill="url(#pl-water)" />
      {Array.from({ length: 13 }, (_, i) => (
        <path
          d={`M0 ${10 + i * 7} Q 36 ${4 + i * 7} 72 ${11 + i * 7} T 144 ${10 + i * 7} T 216 ${12 + i * 7}`}
          fill="none" stroke="#EAF7F6" stroke-opacity={0.1 + (i % 4) * 0.07} stroke-width={i % 3 === 0 ? 1.2 : 0.6}
        />
      ))}
      {Array.from({ length: 7 }, (_, i) => (
        <ellipse cx={18 + i * 31} cy={30 + (i % 3) * 22} rx={14 - (i % 3) * 4} ry={4 - (i % 3)} fill="none" stroke="#F6FEFD" stroke-opacity="0.22" stroke-width="0.8" />
      ))}
    </g>
  )}

  {slug === 'papernotes' && (
    /* the sheet itself: a numbered rule grid, one line carrying a red
       comment — the app's own fig.00 grammar at plate scale */
    <g>
      <rect width="216" height="100" fill="#EFEEE9" />
      {Array.from({ length: 11 }, (_, i) => {
        const y = 12 + i * 8;
        /* indentation as elevation: the ink steps in and out as it would
           on a real sheet, and line 05 runs as a comment */
        const indent = [0, 0, 6, 6, 12, 0, 6, 6, 0, 12, 6][i];
        const len = [124, 92, 64, 108, 48, 0, 86, 118, 71, 40, 96][i];
        const comment = i === 5;
        return (
          <g>
            <line x1={26} y1={y} x2={200} y2={y} stroke="#1A1815" stroke-opacity="0.12" stroke-width="0.5" />
            <text x={20} y={y - 1.5} text-anchor="end" font-family="IBM Plex Mono, monospace" font-size="4"
                  fill="#1A1815" fill-opacity="0.34">{String(i + 1).padStart(2, '0')}</text>
            {len > 0 && (
              <rect x={26 + indent} y={y - 4.6} width={len} height="2.5" rx="0.4"
                    fill="#2A2A28" fill-opacity={i % 4 === 0 ? 0.78 : 0.42} />
            )}
            {comment && (
              <text x={26} y={y - 1.6} font-family="Radley, Georgia, serif" font-style="italic" font-size="5.4"
                    fill="#A33A2A">// indentation as elevation</text>
            )}
          </g>
        );
      })}
      <line x1={26} y1={4} x2={26} y2={96} stroke="#1A1815" stroke-opacity="0.1" stroke-width="0.5" />
    </g>
  )}

  {slug === 'lightwidget' && (
    /* the daylight arc: the sun on its track, the panel warming from the
       side the light comes from. Three panels, three times of day. */
    <g>
      <defs>
        <linearGradient id="pl-day" x1="0" y1="0" x2="0.35" y2="1">
          <stop offset="0" stop-color="#F2E3C2" /><stop offset="1" stop-color="#D6C097" />
        </linearGradient>
        <linearGradient id="pl-dusk" x1="0" y1="0" x2="0.2" y2="1">
          <stop offset="0" stop-color="#E9A283" /><stop offset="0.55" stop-color="#C0839A" /><stop offset="1" stop-color="#6E6288" />
        </linearGradient>
        <linearGradient id="pl-night" x1="0" y1="0" x2="0.2" y2="1">
          <stop offset="0" stop-color="#4B4F69" /><stop offset="1" stop-color="#33364C" />
        </linearGradient>
        <radialGradient id="pl-sun"><stop offset="0" stop-color="#FFFDF6" /><stop offset="1" stop-color="#FFFDF6" stop-opacity="0" /></radialGradient>
      </defs>
      <rect width="216" height="100" fill="#141416" />
      {[
        { x: 6, fill: 'url(#pl-day)', a: -0.72, ink: '#4A4234' },
        { x: 76, fill: 'url(#pl-dusk)', a: 0.16, ink: '#4A3140' },
        { x: 146, fill: 'url(#pl-night)', a: 1.15, ink: '#C9CCDD' },
      ].map((p) => {
        /* the sun rides the arc; its angle is the time of day */
        const cx = p.x + 32, cy = 50, r = 19;
        const sx = cx + Math.cos(Math.PI + p.a) * r;
        const sy = cy + Math.sin(Math.PI + p.a) * r;
        return (
          <g>
            <rect x={p.x} y={6} width="64" height="88" rx="9" fill={p.fill} />
            <circle cx={cx} cy={cy} r={r} fill="none" stroke={p.ink} stroke-opacity="0.3" stroke-width="0.7" />
            <circle cx={sx} cy={sy} r="9" fill="url(#pl-sun)" opacity="0.85" />
            <circle cx={sx} cy={sy} r="2.6" fill="#FFFDF6" />
            <rect x={cx - 13} y={cy - 2.4} width="26" height="4.6" rx="0.6" fill={p.ink} fill-opacity="0.72" />
            <rect x={cx - 8} y={cy + 5} width="16" height="1.5" rx="0.4" fill={p.ink} fill-opacity="0.4" />
          </g>
        );
      })}
    </g>
  )}
</svg>

<style>
  .plate { display: block; width: 100%; height: 100%; }
</style>
