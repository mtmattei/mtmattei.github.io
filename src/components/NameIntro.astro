28 C 189.7 28.1, 198.3 27.7, 200.8 27.8 C 203.2 27.8, 201.7 28.4, 201.8 28.6 M 210 42.8 C 209.5 42.8, 208.9 42.3, 206.8 43 C 204.6 43.7, 199.8 46.1, 197.3 47 C 194.8 47.9, 193 48.1, 191.8 48.3 C 190.5 48.4, 189.9 48.6, 189.5 47.8 C 189.1 46.9, 189.4 43.8, 189.4 43 M 208.3 27 C 208.4 27.1, 206 27.5, 209 27.8 C 212 28, 222.4 28.3, 226 28.8 C 229.6 29.3, 230 30.4, 230.8 30.8" />
      </svg>
