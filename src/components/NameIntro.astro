---
/* The name, as the site's opening.

   A sticky scene the page scrolls through before the landing: cyan MATT
   enters top-left, red MATTEI enters bottom-right, they meet on one
   baseline where the shared MATT registers as an anaglyph. The release
   and the rise are one move: the name rises and reduces toward the top
   edge while the scene slides up and the landing rises into the frame
   beneath it. The name is viewport-fixed, so it docks at the head of
   the page and stays there - the hero arrives right beneath it.

   Ported from the scroll prototype (variant 01, Anaglyph Rise) with the
   prototype's own instrumentation dropped - the variant switcher, the
   01/04 counter, the study copy, the phase captions and the progress
   bar were there to compare variants, not to ship. What stays is the
   choreography, the registration guide and the pulse.

   Type is BigShoulders 800, the landing's own display face, so the name
   hands off to IDEAS, EXPERIMENTS, AND LESSONS in the same voice. The
   red and cyan are true anaglyph channels, not the house accent: the
   effect is the two channels failing to register, so it needs both. */
---

<div id="tstage" aria-hidden="false">
  <div class="tscene">

    <div class="tguide" aria-hidden="true"></div>
    <div class="tpulse" aria-hidden="true"></div>

    <div class="tname" role="img" aria-label="Matt Mattei">
      <p class="tword tw-cyan" id="twGiven" aria-hidden="true">MATT</p>
      <p class="tword tw-red" id="twShared" aria-hidden="true">MATT</p>
      <p class="tword tw-red" id="twTail" aria-hidden="true">EI</p>

      <!-- cyan writes only Matt; red writes only Mattei. Both boxes share
           one coordinate system, with Mattei shifted so its Matt letters
           sit exactly where the cyan Matt sits: at the meet, the shared
           word registers and the ei runs out red-only - the cursive twin
           of the typographic MATT / MATTEI. -->
      <svg class="tsig tsig-cyan" id="tsigCyan" viewBox="0 0 1150 360" aria-hidden="true">
        <path class="flow" pathLength="1" d="M 35 245
          C 55 245, 61 92, 110 92
          C 160 92, 145 245, 188 245
          C 228 245, 228 110, 278 110
          C 328 110, 312 245, 355 245
          C 382 245, 386 179, 420 151
          C 459 119, 518 130, 520 183
          C 522 232, 468 258, 427 229
          C 390 202, 408 151, 451 151
          C 497 151, 507 245, 548 245
          C 566 220, 584 120, 596 62
          C 600 40, 616 40, 620 62
          C 630 120, 616 185, 622 229
          C 628 258, 664 250, 686 237
          C 700 230, 712 120, 726 62
          C 730 40, 746 40, 750 62
          C 760 120, 746 185, 752 229
          C 758 258, 794 250, 816 237" />
        <path class="details" pathLength="1" d="M 566 129 C 590 121, 627 118, 665 124
          M 696 129 C 720 121, 757 118, 795 124" />
      </svg>

      <svg class="tsig tsig-red" id="tsigRed" viewBox="0 0 1150 360" aria-hidden="true">
        <g transform="translate(-874, 0)">
          <path class="flow" pathLength="1" d="M 909 218
            C 931 221, 938 95, 982 95
            C 1029 95, 1017 245, 1058 245
            C 1099 245, 1099 110, 1148 110
            C 1197 110, 1182 245, 1224 245
            C 1252 245, 1256 179, 1290 151
            C 1330 119, 1388 131, 1390 183
            C 1392 232, 1339 258, 1298 229
            C 1261 202, 1279 151, 1322 151
            C 1368 151, 1378 245, 1418 245
            C 1436 220, 1454 120, 1466 62
            C 1470 40, 1486 40, 1490 62
            C 1500 120, 1486 185, 1492 229
            C 1498 258, 1534 250, 1557 237
            C 1570 230, 1582 120, 1596 62
            C 1600 40, 1616 40, 1620 62
            C 1630 120, 1616 185, 1622 229
            C 1628 258, 1664 250, 1688 237
            C 1718 218, 1758 182, 1760 158
            C 1762 132, 1738 122, 1720 139
            C 1699 159, 1707 210, 1743 229
            C 1774 246, 1807 239, 1837 219
            C 1852 207, 1855 140, 1870 140
            C 1888 140, 1885 238, 1910 238
            C 1935 238, 1970 205, 1997 169" />
          <path class="details" pathLength="1" d="M 1430 129 C 1454 121, 1491 118, 1529 124
            M 1561 129 C 1585 121, 1622 118, 1660 124
            M 1858 96 C 1868 84, 1880 84, 1890 96" />
        </g>
      </svg>
    </div>

    <div class="tcue" id="tcue">
      <span class="tcue-line" aria-hidden="true"></span>SCROLL
    </div>

  </div>
</div>

<style is:global>
/* the scroll budget of the whole sequence. 240vh = 140vh of choreography
   (the scene is stuck for that: enter, meet, register) + 100vh of release,
   where the name makes its rise WHILE the scene slides up and the landing
   rises into the frame. One number to retune. */
#tstage { position: relative; height: 240vh; }

.tscene {
  position: sticky;
  top: 0;
  height: 100vh;
  height: 100svh;
  overflow: hidden;
  /* the words register by multiplying against each other, so the blend
     needs a group of its own and an opaque ground under it. This is the
     site ground from global.css, unfixed: while the scene is stuck it is
     viewport-anchored anyway, and the two tones differ by 1/255. */
  isolation: isolate;
  background: radial-gradient(125% 125% at 24% 16%,
              var(--paper) 0%, var(--paper) 46%, var(--paper-2) 100%);
}

/* measurement field: near-invisible at rest, firming up as the name
   resolves. Masked top and bottom so it has no edge of its own. */
.tscene::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: calc(.02 + var(--tp, 0) * .05);
  background-image:
    linear-gradient(to right, var(--line) 1px, transparent 1px),
    linear-gradient(to bottom, var(--line) 1px, transparent 1px);
  background-size: min(9vw, 118px) min(9vw, 118px);
  transform: translateY(calc(var(--tp, 0) * -4vh));
  -webkit-mask-image: linear-gradient(to bottom, transparent 2%, #000 18%, #000 82%, transparent 98%);
  mask-image: linear-gradient(to bottom, transparent 2%, #000 18%, #000 82%, transparent 98%);
}

/* ---- the name ---- */
/* fixed, not scene-local: the name docks at the head of the page and STAYS
   when the scene departs - it never scrolls out of view. Isolated so the
   two channels still multiply against each other. */
.tname { position: fixed; inset: 0; z-index: 5; isolation: isolate; pointer-events: none; }

.tword {
  position: absolute;
  left: 0;
  top: 0;
  margin: 0;
  font-family: 'BigShoulders', 'Arial Narrow', sans-serif;
  font-weight: 800;
  font-size: clamp(84px, 16vw, 250px);
  line-height: .76;
  letter-spacing: -.02em;
  text-transform: uppercase;
  white-space: nowrap;
  transform-origin: left top;
  will-change: transform, opacity, filter;
  user-select: none;
  -webkit-user-select: none;
  font-kerning: none;
  /* JS writes the transform on first frame; until then it stays off-frame
     rather than stacked at the origin */
  opacity: 0;
}

.tw-cyan { z-index: 4; color: #00A9D6; mix-blend-mode: multiply; }
.tw-red  { z-index: 3; color: #EF3E35; mix-blend-mode: multiply; }

/* ---- the cursive Lissajous signature (default; ?intro=type for words) ----
   the name as one plotted line, matching the logo's oscilloscope voice.
   Same anaglyph rules as the words: two channels, multiply, fringe. */
.tsig {
  position: absolute;
  left: 0;
  top: 0;
  /* narrower than the prototype's 90vw: the trace has to fit a corner
     with margin to spare, or the two channels can't oppose diagonally */
  width: min(64vw, 1180px);
  height: auto;
  overflow: visible;
  transform-origin: left top;
  opacity: 0;
  mix-blend-mode: multiply;
  will-change: transform, opacity, filter;
  pointer-events: none;
}
.tsig path {
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-dasharray: 1;
  stroke-dashoffset: 1;
  shape-rendering: geometricPrecision;
}
.tsig .flow    { stroke-width: 6.6; }
.tsig .details { stroke-width: 5.4; }
.tsig-cyan { z-index: 4; }
.tsig-red  { z-index: 3; }
.tsig-cyan path { stroke: #00A9D6; }
.tsig-red  path { stroke: #EF3E35; }

/* ---- registration marks ---- */
.tguide {
  position: absolute;
  z-index: 1;
  left: 50%;
  top: 50%;
  width: min(72vw, 1040px);
  height: 1px;
  background: var(--ink);
  opacity: var(--tguide-o, 0);
  transform: translate(-50%, -50%) scaleX(var(--tguide-s, 0));
  transform-origin: center;
  pointer-events: none;
}
.tguide::after {
  content: '';
  position: absolute;
  left: 50%;
  top: -5px;
  width: 1px;
  height: 11px;
  background: var(--ink);
}

.tpulse {
  position: absolute;
  z-index: 2;
  left: 50%;
  top: 50%;
  width: clamp(118px, 17vw, 250px);
  aspect-ratio: 1;
  border: 1px solid rgba(0, 169, 214, .46);
  border-radius: 50%;
  opacity: var(--tpulse-o, 0);
  transform: translate(-50%, -50%) scale(var(--tpulse-s, .72));
  pointer-events: none;
}
.tpulse::before {
  content: '';
  position: absolute;
  inset: 12%;
  border: 1px solid rgba(239, 62, 53, .42);
  border-radius: inherit;
}

/* ---- scroll cue: the landing's own label metrics ---- */
.tcue {
  position: absolute;
  z-index: 5;
  left: max(18px, 3.8vw);
  bottom: 34px;
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1.8px;
  color: var(--ink);
  pointer-events: none;
  opacity: calc(.78 - min(1, var(--tp, 0) * 5));
}
.tcue-line {
  width: 30px;
  height: 1.5px;
  background: currentColor;
  transform-origin: left;
  animation: tbreathe 1.7s cubic-bezier(.22, 1, .36, 1) infinite;
}
@keyframes tbreathe {
  0%, 100% { transform: scaleX(.25); opacity: .35; }
  50%      { transform: scaleX(1);   opacity: 1; }
}

/* the landing's side rail belongs to the landing: it arrives with it */
body:not(.title-done) .lrail { opacity: 0; pointer-events: none; }

@media (max-width: 820px) {
  #tstage { height: 220vh; }
  .tword { font-size: clamp(56px, 21vw, 120px); }
  .tsig { width: 86vw; }
  .tcue { bottom: 26px; }
}

/* no scroll choreography: the registered name reads as a title card and
   scrolls away with the page */
@media (prefers-reduced-motion: reduce) {
  #tstage { height: 100vh; height: 100svh; }
  .tcue-line { animation: none; }
  /* the still pose is a title card: it belongs to the scene and scrolls
     away with it, so it must not stay pinned over the page */
  .tname { position: absolute; }
}
</style>

<script is:inline>
(function () {
  var root = document.documentElement;
  var stage = document.getElementById('tstage');
  var given = document.getElementById('twGiven');    /* MATT, cyan channel */
  var shared = document.getElementById('twShared');  /* MATT, red channel  */
  var tail = document.getElementById('twTail');      /* EI, red channel    */
  var sigCyan = document.getElementById('tsigCyan');
  var sigRed = document.getElementById('tsigRed');
  if (!stage || !given || !shared || !tail || !sigCyan || !sigRed) return;
  var sigCyanPaths = [].slice.call(sigCyan.querySelectorAll('path'));
  var sigRedPaths = [].slice.call(sigRed.querySelectorAll('path'));

  /* which treatment plays: the cursive Lissajous signature by default,
     ?intro=type for the typographic anaglyph. Both stay wired so the two
     can be compared on the real page. */
  var MODE = /[?&]intro=type\b/.test(location.search) ? 'type' : 'liss';

  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function clamp(v, a, b) {
    a = a == null ? 0 : a; b = b == null ? 1 : b;
    return Math.min(b, Math.max(a, v));
  }
  function mix(a, b, t) { return a + (b - a) * t; }
  function easeInOut(t) { return t < .5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2; }
  function easeOut(t) { return 1 - Math.pow(1 - t, 3); }
  function easeIn(t) { return t * t * t; }

  /* every position is derived from the measured words, so the sequence
     holds at any width and after the display face swaps in */
  var m = null;
  function measure() {
    var vw = innerWidth, vh = innerHeight;
    var sharedW = shared.offsetWidth;
    var fullW = sharedW + tail.offsetWidth;
    var h = Math.max(given.offsetHeight, shared.offsetHeight);
    var marginX = Math.max(18, vw * .038);
    var marginY = Math.max(84, vh * .12);
    var centerY = vh * .5 - h * .5;
    /* the two channels register on MATT, but the word the eye reads is
       MATTEI - centre the composite, or the shared half sits on the axis
       and the whole name looks pushed right by half of EI */
    var centerX = vw * .5 - fullW * .5;
    var hold = Math.min(vw * .18, Math.max(92, sharedW * .72));
    m = {
      vw: vw, vh: vh, sharedW: sharedW, fullW: fullW, centerY: centerY, centerX: centerX,
      givenStart: { x: marginX, y: marginY },
      surnameStart: { x: vw - fullW - marginX, y: vh - h - marginY },
      leftHold: centerX - hold,
      rightHold: centerX + hold,
      finalTop: Math.max(24, vh * .035),
      fringe: Math.min(6, Math.max(3, vw * .004)),
      sigW: sigCyan.clientWidth,
      sigH: sigCyan.clientHeight
    };
  }

  function place(el, x, y, s, blur) {
    el.style.transform = 'translate3d(' + x + 'px,' + y + 'px,0) scale(' + s + ')';
    el.style.opacity = '1';
    el.style.filter = blur ? 'blur(' + blur + 'px)' : 'none';
  }

  /* T runs 0..2: 0..1 is the stuck choreography (the 140vh the scene is
     pinned), 1..2 is the release (the scene's own 100vh slide). The rise
     is driven by the release, so the name retreats to the top and back at
     exactly the rate the landing rises in underneath - one move, not two
     beats. Both treatments share the driver; only the drawing differs. */
  function render(T) {
    if (!m) measure();
    var p = Math.min(1, T);
    var q = clamp(T - 1);
    root.style.setProperty('--tp', p.toFixed(4));
    if (MODE === 'type') renderType(p, q); else renderLiss(p, q);
    /* the rail belongs to the landing: it arrives once the landing is
       genuinely on its way up */
    document.body.classList.toggle('title-done', T >= 1.12);
  }

  function renderType(p, q) {
    /* enter from the corners, hold either side of centre, then meet */
    var enter = easeInOut(clamp(p / .36));
    var meet = easeInOut(clamp((p - .31) / .34));
    /* the fringe only opens once the two channels are on the same baseline */
    var registered = easeOut(clamp((p - .57) / .13));
    /* the name is viewport-fixed, so the rise is viewport-true while the
       scene slides up underneath it: it retreats to the head of the page
       and stays there - the hero arrives right beneath it. */
    var r = easeInOut(clamp(q / .6));

    var scale = mix(1, .235, r);
    var fringe = m.fringe * registered * (1 - r * .35);
    var topX = m.vw * .5 - m.fullW * scale * .5;

    var gx = mix(mix(m.givenStart.x, m.leftHold, enter), m.centerX, meet);
    var gy = mix(m.givenStart.y, m.centerY, enter);
    var sx = mix(mix(m.surnameStart.x, m.rightHold, enter), m.centerX, meet);
    var sy = mix(m.surnameStart.y, m.centerY, enter);

    var cyanX = mix(gx, topX, r) - fringe;
    var cyanY = mix(gy, m.finalTop, r);
    var redX = mix(sx, topX, r) + fringe;
    var redY = mix(sy, m.finalTop, r);
    /* a touch of blur through the middle of the rise reads as travel; it
       clears again at the dock so the resting name is sharp */
    var bu = clamp((r - .35) / .65);
    var blur = 1.1 * (1 - Math.abs(2 * bu - 1));

    place(given, cyanX, cyanY, scale, blur);
    place(shared, redX, redY, scale, blur);
    place(tail, redX + m.sharedW * scale, redY, scale, blur);

    var pulse = Math.max(0, 1 - Math.abs(clamp((p - .61) / .19) * 2 - 1));
    root.style.setProperty('--tguide-o', (.28 * (1 - r) * easeOut(clamp((p - .23) / .26))).toFixed(4));
    root.style.setProperty('--tguide-s', easeOut(clamp((p - .26) / .26)).toFixed(4));
    root.style.setProperty('--tpulse-o', (.34 * pulse).toFixed(4));
    root.style.setProperty('--tpulse-s', mix(.72, 1.12, pulse).toFixed(4));
  }

  /* the plotter, in handwriting order per channel: the word's flow first,
     then its crossbars (and, for Mattei, the i dot) */
  var DRAW = [
    { at: 0,   span: .62 },   /* the word's flow */
    { at: .66, span: .34 }    /* crossbars + dot */
  ];
  function setDraw(paths, t) {
    for (var i = 0; i < paths.length; i++) {
      var d = DRAW[i] || DRAW[DRAW.length - 1];
      paths[i].style.strokeDashoffset = String(1 - easeOut(clamp((t - d.at) / d.span)));
    }
  }

  function renderLiss(p, q) {
    /* the same choreography as the words - cyan Matt in from the top-left,
       red Mattei in from the bottom-right, hold either side of centre,
       meet so the shared Matt registers, rise with the release, dock and
       stay. The only Lissajous-specific behavior is that the traces plot
       themselves on the way to the meet. */
    var enter = easeInOut(clamp(p / .36));
    var meet = easeInOut(clamp((p - .31) / .34));
    var registered = easeOut(clamp((p - .57) / .13));
    var r = easeInOut(clamp(q / .6));

    var scale = mix(1, .235, r);
    /* both traces carry the full name, so they register completely; the
       fringe misprints on both axes like a plate slipped on the press */
    var fringe = m.fringe * 1.18 * registered * (1 - r * .35);

    var centerX = m.vw * .5 - m.sigW * .5;
    var centerY = m.vh * .5 - m.sigH * .5;
    var hold = Math.min(m.vw * .18, Math.max(92, m.sigW * .18));
    var marginX = Math.max(18, m.vw * .038);
    var marginY = Math.max(84, m.vh * .12);

    var gx = mix(mix(marginX, centerX - hold, enter), centerX, meet);
    var gy = mix(marginY, centerY, enter);
    var sx = mix(mix(m.vw - m.sigW - marginX, centerX + hold, enter), centerX, meet);
    var sy = mix(m.vh - m.sigH - marginY, centerY, enter);

    var topX = m.vw * .5 - m.sigW * scale * .5;
    var cyanX = mix(gx, topX, r) - fringe;
    var cyanY = mix(gy, m.finalTop, r) - fringe * .18;
    var redX = mix(sx, topX, r) + fringe;
    var redY = mix(sy, m.finalTop, r) + fringe * .18;

    var bu = clamp((r - .35) / .65);
    var blur = .75 * (1 - Math.abs(2 * bu - 1));

    setDraw(sigCyanPaths, clamp(p / .52));
    setDraw(sigRedPaths, clamp((p - .05) / .52));
    sigCyan.style.opacity = easeOut(clamp(p / .09)).toFixed(4);
    sigRed.style.opacity = easeOut(clamp((p - .025) / .09)).toFixed(4);
    sigCyan.style.transform = 'translate3d(' + cyanX + 'px,' + cyanY + 'px,0) scale(' + scale + ')';
    sigRed.style.transform = 'translate3d(' + redX + 'px,' + redY + 'px,0) scale(' + scale + ')';
    sigCyan.style.filter = blur > .01 ? 'blur(' + blur + 'px)' : 'none';
    sigRed.style.filter = blur > .01 ? 'blur(' + blur + 'px)' : 'none';

    var pulse = Math.max(0, 1 - Math.abs(clamp((p - .61) / .19) * 2 - 1));
    root.style.setProperty('--tguide-o', (.28 * (1 - r) * easeOut(clamp((p - .23) / .26))).toFixed(4));
    root.style.setProperty('--tguide-s', easeOut(clamp((p - .26) / .26)).toFixed(4));
    root.style.setProperty('--tpulse-o', (.34 * pulse).toFixed(4));
    root.style.setProperty('--tpulse-s', mix(.72, 1.12, pulse).toFixed(4));
  }

  if (reduce) {
    /* the registered pose, held: no scroll mapping, no frame loop */
    var still = function () { measure(); render(.85); };
    still();
    addEventListener('resize', still);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(still);
    document.body.classList.add('title-done');
    return;
  }

  var current = 0;
  var geo = { top: 0, stick: 1, release: 1 };

  function measureGeo() {
    geo.top = stage.offsetTop;
    geo.release = Math.max(1, innerHeight);
    geo.stick = Math.max(1, stage.offsetHeight - geo.release);
  }
  /* read from scrollY rather than from a scroll event: restoration on reload,
     anchor jumps and programmatic scrolls all move the page without one, and
     a stale target leaves the name posed for a position the page is not at */
  function targetNow() {
    var s = scrollY - geo.top;
    return s <= geo.stick
      ? clamp(s / geo.stick)
      : 1 + clamp((s - geo.stick) / geo.release);
  }

  /* the name trails the wheel slightly - the sequence reads as one move
     being made rather than as scroll position being reported. A jump is not
     a wheel, so anything that big lands instead of sweeping through the
     whole choreography to catch up. */
  function tick() {
    var target = targetNow();
    var d = target - current;
    current = Math.abs(d) > .25 ? target : current + d * .095;
    if (Math.abs(target - current) < .00008) current = target;
    render(current);
    requestAnimationFrame(tick);
  }

  measure();
  measureGeo();
  current = targetNow();
  render(current);
  requestAnimationFrame(tick);

  addEventListener('resize', function () { measure(); measureGeo(); });
  /* the display face lands after first paint on a cold cache; every
     position is measured from it, so re-measure once it is real */
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(function () { measure(); render(current); });
  }
})();
</script>
