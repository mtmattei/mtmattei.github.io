<style is:global>
/* fixed at the head of the page, above the relay cards (z9) but under the
   walked-in worlds (z10) */
#sigdock {
  position: fixed; left: 50%; top: max(20px, 3.2vh); z-index: 9;
  transform: translateX(-50%);
  pointer-events: none;
  transition-property: opacity; transition-duration: .35s; transition-timing-function: ease-out;
}
/* the mark prints on paper: while a full-bleed card owns the head of the
   frame it steps aside, and returns as the card recedes */
body.relay-live #sigdock, body.walked #sigdock { opacity: 0; }
.tmark {
  position: relative; display: flex; align-items: flex-start;
  /* the docked scale of the retired rise (.235 of the full plate), so the
     mark reads exactly as it did at the end of the old choreography */
  transform: scale(.235); transform-origin: center top;
  isolation: isolate;
  pointer-events: auto;
  transition-property: transform;
  transition-duration: .6s; transition-timing-function: cubic-bezier(.22, 1, .36, 1);
}
body.relay-live .tmark { pointer-events: none; }
/* the hover field: generous, and wide enough that following the pen to
   either end of the drawn autograph never drops the hover */
.tmark::after { content: ''; position: absolute; inset: -40px -520px -60px; }
.tmark-m { width: calc(min(64vw, 1180px) * .167); height: auto; overflow: visible; }
.tmark-m path, .tsig-eg path {
  fill: none; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round;
  mix-blend-mode: multiply;
}
.tmark-m .mk-cyan, .eg-cyan path { stroke: #00A9D6; }
.tmark-m .mk-red,  .eg-red path  { stroke: #EF3E35; }
.tmark-exp {
  font-family: 'BigShoulders', 'Arial Narrow', sans-serif; font-weight: 800;
  font-size: calc(min(64vw, 1180px) * .062); line-height: 1;
  color: var(--ink); margin-left: .5vw; transform: translateY(-14%);
  transition-property: opacity, transform;
  transition-duration: .3s; transition-timing-function: ease-out;
}

/* ---- easter egg: the pen finishes the autograph ----
   The plates share the mark's unit scale: mark width is the M's 86-unit
   share of the 515-unit plate, so plate x0/y0 sits 2/3 units up-left of
   the mark's box. Drawn by dashoffset out of the M; cyan (Matt) leads,
   red (Mattei) follows; retract runs in reverse order. */
.tsig-eg {
  position: absolute;
  left: calc(min(64vw, 1180px) * .167 / 86 * -2);
  top: calc(min(64vw, 1180px) * .167 / 86 * -3);
  width: min(64vw, 1180px); height: auto; overflow: visible;
  pointer-events: none;
}
.tsig-eg path {
  stroke-dasharray: 1; stroke-dashoffset: 1;
  transition-property: stroke-dashoffset;
  transition-duration: .5s; transition-timing-function: cubic-bezier(.45, .05, .35, 1);
}
.eg-cyan path { transition-delay: .14s; }   /* closing: red retracts first */
.eg-red path  { transition-delay: 0s; }
#sigdock.open .eg-cyan path { stroke-dashoffset: 0; transition-delay: 0s; transition-duration: .55s; }
#sigdock.open .eg-red path  { stroke-dashoffset: 0; transition-delay: .2s; transition-duration: .6s; }
/* the mark's own strokes yield while the plates retrace them, so the
   multiply blend never doubles the M's ink */
.tmark-m path { transition-property: opacity; transition-duration: .12s; transition-timing-function: linear; transition-delay: .5s; }
#sigdock.open .tmark-m path { opacity: 0; transition-delay: .05s; }
/* the composition glides left so the finished autograph sits centred:
   half of the plates' extra width (429 units), at the docked scale */
#sigdock.open .tmark { transform: translateX(calc(min(64vw, 1180px) * -.0979)) scale(.235); }
/* the exponent gives way to the real tail */
#sigdock.open .tmark-exp { opacity: 0; transform: translateY(-14%) translateX(10px); }

@media (max-width: 820px) {
  .tmark-m { width: calc(86vw * .167); }
  .tmark-exp { font-size: calc(86vw * .062); }
  .tsig-eg { left: calc(86vw * .167 / 86 * -2); top: calc(86vw * .167 / 86 * -3); width: 86vw; }
  #sigdock.open .tmark { transform: translateX(calc(86vw * -.0979)) scale(.235); }
  .tmark::after { inset: -30px -46vw -40px; }
}
@media (prefers-reduced-motion: reduce) {
  #sigdock, .tmark, .tsig-eg path, .tmark-m path, .tmark-exp { transition-duration: .01ms; }
}
</style>

<script is:inline>
(function () {
  /* the monogram's M is the signature's opening stroke, cloned so the two
     never drift apart */
  var src = document.querySelector('.eg-cyan path');
  var dock = document.getElementById('sigdock');
  var mark = document.getElementById('tmark');
  if (!src || !dock || !mark) return;
  var mD = src.getAttribute('d').split(/ M /)[0];
  [].forEach.call(mark.querySelectorAll('.tmark-m path'), function (p) {
    p.setAttribute('d', mD);
  });
  mark.addEventListener('pointerenter', function () { dock.classList.add('open'); });
  mark.addEventListener('pointerleave', function () { dock.classList.remove('open'); });
})();
</script>
