---
/* The wind run: how the index leaves the page. EXPERIMENT.

   Once the hero has risen into its spot the page keeps scrolling, but the
   stage pins: the index rows stream up through the frame and split around
   the billboard like wind hitting a rock. Each cell of a row takes the
   side of the stream it is already on, bows out just far enough to clear
   the silhouette, tilts into the turn, and rejoins the stream above. The
   spacer below hands the flow its scroll budget; the pin releases once
   the last row has cleared the top of the frame.

   The rock is a Gaussian field around the billboard: influence
   g = exp(-(dy/ry)^2) by vertical distance, deflection = the exact
   overlap each cell needs to clear the rock edge, scaled by g. Each cell
   trails its target at its own rate - that lag, not the field, is what
   makes the motion read as fluid. */
---

<div id="windrun" aria-hidden="true"></div>

<style is:global>
#windrun { height: 0; }
</style>

<script is:inline>
(function () {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var fit, run, tv, camera, cells, heroTop = 0, scale = 1, budget = 1, rock = null;
  var active = false, primed = false;

  function measureAll() {
    /* measure at rest: strip the pin and every cell transform first */
    fit.style.transform = '';
    cells.forEach(function (c) { c.el.style.transform = ''; });
    void fit.offsetWidth;

    heroTop = fit.offsetTop;
    scale = camera.getBoundingClientRect().width / Math.max(1, camera.offsetWidth);

    var fr = fit.getBoundingClientRect();
    var tb = tv.getBoundingClientRect();
    rock = {
      l: tb.left - 26, r: tb.right + 26,
      cx: tb.left + tb.width / 2,
      cy: tb.top - fr.top + tb.height / 2,
      ry: tb.height / 2 + 44
    };
    var last = 0;
    cells.forEach(function (c) {
      var b = c.el.getBoundingClientRect();
      c.base = { l: b.left, r: b.right, cx: b.left + b.width / 2, cy: b.top - fr.top };
      last = Math.max(last, c.base.cy);
    });
    /* enough scroll for the last row to clear the top of the frame */
    budget = Math.ceil(last + 90);
    run.style.height = budget + 'px';
  }

  function tick() {
    var w = Math.min(budget, Math.max(0, scrollY - heroTop));

    if (w <= 0) {
      if (active) {
        /* hand the rows back to the page: natural layout, natural hovers */
        fit.style.transform = '';
        cells.forEach(function (c) { c.el.style.transform = ''; c.x = 0; c.tilt = 0; });
        active = false;
      }
      requestAnimationFrame(tick);
      return;
    }

    if (!active) {
      active = true;
      cells.forEach(function (c) { c.el.style.willChange = 'transform'; });
    }

    /* the pin: the hero holds its spot while the scrollbar keeps moving */
    fit.style.transform = 'translate3d(0,' + w + 'px,0)';

    for (var i = 0; i < cells.length; i++) {
      var c = cells[i];
      var cy = c.base.cy - w;                       /* where the stream has carried it */
      var dyn = (cy - rock.cy) / rock.ry;
      var g = Math.exp(-dyn * dyn);
      var side = c.base.cx < rock.cx ? -1 : 1;
      var needed = side < 0
        ? Math.max(0, c.base.r - rock.l)
        : Math.max(0, rock.r - c.base.l);
      var tx = side * needed * g;
      var tilt = Math.max(-7, Math.min(7, side * dyn * g * 6));

      /* per-cell lag: neighbours answer the field at different rates */
      var k = .085 + (i % 5) * .012;
      c.x += (tx - c.x) * k;
      c.tilt += (tilt - c.tilt) * k;

      /* cell transforms live inside the scaled camera, so viewport px
         convert back through the camera scale; rotation is scale-free */
      c.el.style.transform = 'translate3d(' + (c.x / scale).toFixed(2) + 'px,'
        + (-w / scale).toFixed(2) + 'px,0) rotate(' + c.tilt.toFixed(3) + 'deg)';
    }
    requestAnimationFrame(tick);
  }

  /* the camera is scaled by the page's own fit() and the ledger arrives
     staggered, so measure only once everything has really landed */
  addEventListener('load', function () {
    fit = document.getElementById('fit');
    run = document.getElementById('windrun');
    tv = document.getElementById('tv');
    camera = document.querySelector('.camera');
    /* the rock must actually stand in the hero: with the billboard parked
       for the project pages there is nothing to flow around, and the run
       stays inert (no spacer, natural scroll into the index) */
    if (!fit || !run || !tv || !tv.offsetParent || !camera) return;

    var rows = [].slice.call(document.querySelectorAll('#pindex .prow'));
    if (!rows.length) return;
    cells = [];
    rows.forEach(function (row) {
      [].slice.call(row.children).forEach(function (el) {
        cells.push({ el: el, x: 0, tilt: 0, base: null });
      });
    });

    measureAll();
    addEventListener('resize', measureAll);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(measureAll);
    primed = true;
    requestAnimationFrame(tick);
  });
})();
</script>
