.dstack-gauge input[type=range] {
  -webkit-appearance: none; appearance: none; width: 100%; height: 20px; background: transparent; cursor: ew-resize; margin: 0;
}
.dstack-gauge input[type=range]:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
.dstack-gauge input[type=range]::-webkit-slider-runnable-track { height: 1px; background: var(--line-2); }
