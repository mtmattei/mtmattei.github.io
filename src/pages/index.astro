                    new Uint8Array([228, 224, 214, 255]));      // the stock, until the sheet lands
      var img = new Image();
      img.decoding = 'async';
      img.onload = function () {
        gl.bindTexture(gl.TEXTURE_2D, tex[i]);
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        if (mip) {
          gl.generateMipmap(gl.TEXTURE_2D);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR);
        } else gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
        ready[i] = true; show();
      };
      img.src = '/projects/' + p.slug + '-poster.webp';
    });
    hit.classList.add('gl');
    return true;
  }
  var SHADOW = 30;
  function paint(cards, time) {
    gl.viewport(0, 0, cv.width, cv.height);
    gl.clearColor(0, 0, 0, 0);
    gl.clear(gl.COLOR_BUFFER_BIT);
    gl.bindBuffer(gl.ARRAY_BUFFER, quad);
    var i, c;
    gl.useProgram(progS.p);
    gl.enableVertexAttribArray(progS.a);
    gl.vertexAttribPointer(progS.a, 2, gl.FLOAT, false, 0, 0);
    gl.uniform2f(progS.u.uRes, G.vw, G.vh);
    for (i = 0; i < cards.length; i++) {
      c = cards[i]; if (c.a <= 0.004) continue;
      gl.uniform4f(progS.u.uRect, c.x, c.y + c.h * 0.022, c.w, c.h);
      gl.uniform1f(progS.u.uPad, SHADOW);
      gl.uniform1f(progS.u.uRot, c.rot);
      gl.uniform2f(progS.u.uFeat, SHADOW / c.w, SHADOW / c.h);
      gl.uniform1f(progS.u.uAlpha, 0.19 * c.a);
      gl.drawArrays(gl.TRIANGLES, 0, 6);
    }
    gl.useProgram(progP.p);
    gl.enableVertexAttribArray(progP.a);
    gl.vertexAttribPointer(progP.a, 2, gl.FLOAT, false, 0, 0);
    gl.uniform2f(progP.u.uRes, G.vw, G.vh);
    gl.uniform1i(progP.u.uTex, 0);
    gl.uniform1f(progP.u.uTime, time);
    gl.uniform1f(progP.u.uCx, G.cx);
    gl.uniform1f(progP.u.uColR, G.pw * 0.66);
    gl.activeTexture(gl.TEXTURE0);
    for (i = 0; i < cards.length; i++) {
      c = cards[i]; if (c.a <= 0.004) continue;
      gl.bindTexture(gl.TEXTURE_2D, tex[c.p]);
      gl.uniform4f(progP.u.uRect, c.x, c.y, c.w, c.h);
      gl.uniform1f(progP.u.uPad, c.w * 0.09);      // bleed, so the lens can pull past the edge
      gl.uniform1f(progP.u.uRot, c.rot);
      gl.uniform1f(progP.u.uHas, ready[c.p] ? 1 : 0);
      gl.uniform1f(progP.u.uW, c.W);
      gl.uniform1f(progP.u.uN, c.n);
      /* the last stretch of the approach, where the sheet settles and the
         drifting field lets go of it: 0 until W passes .82, 1 at dead centre */
      gl.uniform1f(progP.u.uCalm, sm(cl((c.W - 0.82) / 0.18, 0, 1)));
      gl.uniform2f(progP.u.uPx, 1 / c.w, 1 / c.h);
      gl.uniform1f(progP.u.uAlpha, c.a);
      gl.drawArrays(gl.TRIANGLES, 0, 6);
    }
  }

  // ---- the frame ----
  var last = 0, raf = 0, hidden = false, t0 = performance.now();
  function show() {
    hidden = false;
    if (belt.style.visibility) belt.style.visibility = '';
    if (!raf) { last = performance.now(); raf = requestAnimationFrame(tick); }
  }
  function park() {
    hidden = true; belt.style.visibility = 'hidden';
    if (raf) { cancelAnimationFrame(raf); raf = 0; }
  }
  function tick(now) {
    raf = 0;
    var dt = Math.min(0.05, (now - last) / 1000); last = now;

    /* inside a work the belt holds its pose and stops drawing entirely —
       the sheet it handed over is the detail world's own ground now */
    if (state.mode === 'detail' && (ent.t >= 1 || (ent.t === 0 && ent.to === 0))) { park(); return; }

    // ---- where the belt stands ----
    if (glide) {
      glide.t = Math.min(1, glide.t + dt / glide.dur);
      off = mix(glide.from, glide.to, eio(glide.t));
      if (glide.t >= 1) { var then = glide.then; glide = null; if (then) then(); }
    } else if (!dragging && idx.t < 0.02 && ent.t === 0 && ent.to === 0) {
      off += ((reduce ? 0 : BASE) + mom) * dt;
      mom *= Math.exp(-2.4 * dt);
      if (Math.abs(mom) < 0.4) mom = 0;
    }

    // ---- the blends ----
    if (ent.to !== 1) idx.t = approach(idx.t, idx.to, dt / idx.dur);
    if (ent.to === 1 && !glide) ent.t = Math.min(1, ent.t + dt / (reduce ? 0.001 : ent.dur));
    if (ent.to === 0 && ent.t > 0) {
      ent.t = Math.max(0, ent.t - dt / (reduce ? 0.001 : 0.5));
      if (ent.t === 0) ent.slot = -1;
    }
    /* the hash is written partway through the expansion, so the detail world
       fades in over a sheet that is still growing — one continuous move */
    if (ent.to === 1 && !ent.fired && ent.t >= 0.55) {
      ent.fired = true;
      location.hash = '#/p/' + PROJECTS[ent.proj].slug;
    }
    if (ent.to === 1 && ent.t >= 1 && idx.t > 0) { idx.t = idx.to = 0; }
    for (var i = 0; i < N; i++) lift[i] += (liftTo[i] - lift[i]) * (1 - Math.exp(-11 * dt));

    // ---- pose every sheet ----
    var cards = [], best = -1, bestW = 0.12;
    for (var k = 0; k < A.length; k++) {
      var p = k % N;
      var dx = wrap(k * G.pitch - off);
      var cxp = G.cx + dx, cyp = G.cy;
      var w = G.pw, h = G.ph, rot = 0, alpha = 1;
      var n = cl(dx / (G.pitch * 0.95), -1, 1);
      var W = 1 - sm(Math.abs(n));
      var z = 120 - Math.abs(dx) / 10;          // on the belt, the nearest sheet reads on top

      if (idx.t > 0.0001) {
        var pA = sm(cl((idx.t - idx.delay[k]) / 0.62, 0, 1));   // collapse inward
        var pB = sm(cl((idx.t - 0.42) / 0.58, 0, 1));           // and the stack travels right
        var keep = idx.pick[p] === k;
        var si = N - 1 - p;                                     // 01 finishes on top
        var stx = G.vw * (G.vw < 900 ? 0.60 : 0.735);
        var ox = (si - (N - 1) / 2) * 8, oy = (si - (N - 1) / 2) * -6;
        var lf = lift[p] * pB;
        var tx = G.cx + pB * (stx - G.cx + ox) - lf * G.pw * 0.13;
        var ty = G.cy + pB * oy - lf * G.ph * 0.055;
        var gr = 1.05 + lf * 0.05;
        cxp = mix(cxp, tx, pA); cyp = mix(cyp, ty, pA);
        w = mix(w, G.pw * gr, pA); h = mix(h, G.ph * gr, pA);
        rot = pA * pB * ROT[p];
        if (!keep) alpha = 1 - pA;
        /* the threshold is a belt idea: it lets go early in the collapse, so
           the stack forms out of clean sheets rather than smeared ones */
        W *= 1 - Math.min(1, pA * 2);
        z = keep ? (60 + si * 2 + lift[p] * 40) : -1;
      }

      if (ent.t > 0.0001) {
        var e = eio(ent.t);
        if (k === ent.slot) {
          var s = Math.max(G.vw / G.pw, G.vh / G.ph) * 1.02;
          cxp = mix(cxp, G.cx, e); cyp = mix(cyp, G.vh / 2, e);
          w = mix(w, G.pw * s, e); h = mix(h, G.ph * s, e);
          rot *= 1 - e;
          W *= 1 - e;                            // the effect resolves as you walk in
          alpha = 1; z = 500;
        } else {
          cxp += e * (cxp < G.cx ? -1 : 1) * G.vw * 0.62;   // the rest part around it
          alpha *= 1 - Math.min(1, e * 1.6);
        }
      }

      if (W > bestW) { bestW = W; best = p; }
      cards.push({ k: k, p: p, x: cxp - w / 2, y: cyp - h / 2, w: w, h: h, rot: rot, a: alpha, W: W, n: n, z: z });
    }
    cards.sort(function (a, b) { return a.z - b.z; });

    // the anchors ride the same poses: one transform each, never a layout
    for (i = 0; i < cards.length; i++) {
      var c = cards[i], el = A[c.k];
      el.style.transform = 'translate3d(' + c.x.toFixed(2) + 'px,' + c.y.toFixed(2) + 'px,0) rotate(' +
                           (c.rot * 57.2958).toFixed(3) + 'deg) scale(' + (c.w / 100).toFixed(5) + ',' + (c.h / 100).toFixed(5) + ')';
      el.style.zIndex = String(600 + i);
      var vis = c.a > 0.02;
      el.style.opacity = c.a < 1 ? c.a.toFixed(3) : '';
      el.style.pointerEvents = vis ? '' : 'none';
    }
    if (idx.t < 0.4 && ent.t < 0.2) readout(best);
    if (gl) paint(cards, reduce ? 3 : (now - t0) / 1000);

    raf = requestAnimationFrame(tick);
  }

  // ---- input: drag, wheel, swipe. All of it feeds the same offset. ----
  function live() { return state.mode === 'landing' && ent.to !== 1; }
  belt.addEventListener('wheel', function (e) {
    if (!live() || indexIsOpen()) return;
    e.preventDefault();
    var d = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
    d *= (e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? G.vw : 1);
    glide = null;
    off += d * 1.05;
    mom = cl(mom + d * 2.0, -1800, 1800);       // and it coasts back to the belt's pace
    show();
  }, { passive: false });
  belt.addEventListener('pointerdown', function (e) {
    if (!live() || (e.button !== undefined && e.button !== 0)) return;
    dragging = true; moved = 0; vx = 0;
    lastX = e.clientX; lastT = performance.now();
    glide = null; mom = 0;
    belt.classList.add('grabbing');
    try { belt.setPointerCapture(e.pointerId); } catch (err) {}
    show();
  });
  belt.addEventListener('pointermove', function (e) {
    if (!dragging) return;
    var t = performance.now(), dtm = Math.max(8, t - lastT) / 1000;
    var d = e.clientX - lastX;
    lastX = e.clientX; lastT = t;
    moved += Math.abs(d);
    off -= d;
    vx = vx * 0.6 + (d / dtm) * 0.4;
    show();
  });
  ['pointerup', 'pointercancel'].forEach(function (ev) {
    belt.addEventListener(ev, function () {
      if (!dragging) return;
      dragging = false;
      belt.classList.remove('grabbing');
      mom = cl(-vx, -2400, 2400);               // the throw carries, then the belt reclaims it
      show();
    });
  });
  /* a sheet is a link, but a drag that ends on one is not a click */
  hit.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('.pst');
    if (!a) return;
    e.preventDefault();
    if (moved > 6) { moved = 0; return; }
    enter(+a.dataset.p);
  });
  /* tabbing through the work brings each sheet to the threshold, and
     pointing at one inside the stack fronts it exactly as its row does */
  hit.addEventListener('focusin', function (e) {
    var a = e.target.closest && e.target.closest('.pst');
    if (!a || dragging || idx.t > 0.1 || !live()) return;
    var k = +a.dataset.k, dx = wrap(k * G.pitch - off);
    if (Math.abs(dx) < 4) return;
    mom = 0;
    glide = { from: off, to: off + dx, t: 0, dur: reduce ? 0.001 : 0.42, then: null };
    show();
  });
  hit.addEventListener('pointerover', function (e) {
    var a = e.target.closest && e.target.closest('.pst');
    if (!a || idx.t < 0.9) return;
    var row = document.querySelector('#pindex .prow[data-i="' + a.dataset.p + '"]');
    if (row) previewRow(row);
  });

  var reT = 0;
  addEventListener('resize', function () {
    clearTimeout(reT);
    reT = setTimeout(function () { measure(); show(); }, 90);
  });

  measure();
  if (!initGL()) cv.style.display = 'none';     // no WebGL: the anchors' own <img> stands in
  beltApi = { enter: enter, exit: exit, toIndex: toIndex, front: setFront, wake: show };
  show();
})();

route(true);
bbWake();


</script>
