---
import Bare from '../layouts/Bare.astro';
import NameIntro from '../components/NameIntro.astro';
import Plate from '../components/Plate.astro';
import BillboardArt from '../components/BillboardArt.astro';
/* Fraunces: the Poolside app's display face, used in the billboard UI */
import '@fontsource/fraunces/300.css';
import '@fontsource/fraunces/400.css';
/* the Poolside phone build's own styles, scoped under .pworld */
import '../styles/poolside-app.css';
import { highlightSource } from '../data/portfolio';
import { DISPERSION_SRC, CAUSTIC_SRC } from '../data/poolside-src';

/* The landing rebuilt from the billboard mockup (mockup-landing, SPEC.md):
   a fixed 1536×1024 stage fit-scaled to the viewport. Entering a project is
   a walk through the billboard; inside, the project reads as a horizontal
   timeline of its iterations. Exiting reverses the walk.
   Portfolio identity kept: the M mark, the Plates (art drawn by the page),
   the house blue accent for state, Instrument Sans / IBM Plex Mono. */

type Iter = { v: string; title: string; cap: string; rows: string[]; fig?: string };
/* extra world panels beyond the iteration timeline:
   note = a prose panel; app = the running interface; parts = a card grid;
   stack = the exploded shader deck with its legend (from /poolside/) */
type Extra = {
  kind: 'note' | 'app' | 'parts' | 'stack' | 'exploded' | 'code' | 'figure';
  label: string;
  title?: string;
  body?: string;
  rows?: string[];
  items?: { no: string; title: string; body: string; read?: string; lead?: string }[];
  /* a note panel may carry the project's own media beside the text —
     footage plays, a capture renders as a still */
  video?: { src: string; cap: string; sub: string };
  /* a figure panel is the image at plate size, with the reading beneath.
     ratio is the capture's own w/h, which sets the panel's width so the
     rail measures it correctly. */
  fig?: { src: string; cap: string; sub: string; ratio: number };
};
type Proj = {
  slug: string;
  name: string;
  tag: string;
  /* absent href = no case study yet; linkLabel names the destination */
  href?: string;
  linkLabel?: string;
  /* detail-world palette: surface tone, display accent, body ink;
     base is the far radial color (near-black default; paper = light world) */
  deep: string;
  accent: string;
  ink: string;
  base?: string;
  iters: Iter[];
  pre?: Extra[];
  post?: Extra[];
  question?: string;
  /* overrides the "N ITERATIONS" line in the title panel's meta row */
  meta?: string;
  /* hidden projects keep their data but leave the featured set */
  hidden?: boolean;
  /* the case-study page head, carried into the title panel */
  lede?: string;
  facts?: string[];
};

/* the ink the next card's title prints in: per artwork, not per world —
   PaperNotes' sheet is pale even though it rises out of a dark frame */
const RELAY_ART_INK: Record<string, string> = {
  poolside: '#F6F2EE',
  papernotes: '#2A2A28',
  lightwidget: '#F2EDE6',
};

const PROJECTS: Proj[] = [
  {
    /* light world: Poolside's exhibit is paper-and-ink like the rest of the
       site; each iteration's artifact is the live WebGL stage from /poolside/ */
    /* the world IS the Poolside detail page: /poolside/ replicated for the
       horizontal scrolling concept */
    slug: 'poolside', name: 'POOLSIDE', tag: 'UI · SKIASHARP · UNO PLATFORM',
    deep: '#EFE7DD', accent: '#0A6C88', ink: '#1A1815', base: '#F6F2EE',
    meta: '4 STAGES · ONE PASS',
    lede: 'A pool chemistry companion created to explore real-time shaders with SkiaSharp. The experience became a playground for exploring water caustics, real-time shaders, and interactive rendering with SkiaSharp.',
    facts: [
      'Uno Platform · net10.0 · desktop + Android',
      'SkiaSharp 4.148 GA · runtime SkSL water',
      'MVUX · Toolkit TabBar · ShadowContainer',
      'Fraunces readings · Instrument Sans actions',
    ],
    pre: [
      /* the finished product leads; the making-of follows */
      {
        kind: 'app', label: 'APP', title: 'The home screen, running',
        body: 'The surface is an SKCanvasElement inside a folding basin control; chemistry binds to an MVUX IState of PoolSnapshot; the one-sentence insight comes from a DI-registered IWaterAnalyzer. Fraunces carries the readings, Instrument Sans the actions.',
        rows: ['uno platform', 'net10.0', 'desktop + android', 'mvux'],
      },
      {
        /* the exhibit's exploded view, paired with the app it takes apart */
        kind: 'exploded', label: 'EXPLODED', title: 'The interface, exploded.',
        body: 'Explode the interface and its key features lift out of the shell, remaining fully interactive and tethered to their original positions.',
        items: [
          { no: '1', title: 'WaterConditionCanvas · WaterCondition.sksl', lead: 'WaterConditionCanvas is an SKCanvasElement', body: 'running WaterCondition.sksl. Clarity, green, milky, and sediment are DependencyProperties snapshotted to fields for the render thread; the loop is vsync-aligned, capped at 30fps, and lives inside the folding IsoBasin control.' },
          { no: '2', title: 'engraved plate · IState‹PoolSnapshot›', lead: 'One recessed plate, four gauges in a 2×2 grid.', body: 'Toolkit ShadowContainer inner shadows and engraved hairlines. Readings bind to the MVUX IState of PoolSnapshot; a ChemistryExpanded state swaps compact numbers for full range bands.' },
          { no: '3', title: 'IWaterAnalyzer · PoolModel · one line', lead: 'The insight is a service.', body: 'IWaterAnalyzer is DI-registered and injected through the PoolModel(IWaterAnalyzer Analyzer) primary constructor. It reads the snapshot and the test strip (StripReader), then returns one sentence carrying a status tone.' },
          { no: '4', title: 'TrendsModel · Polyline · WaterThumbnail', lead: 'History is a Polyline sparkline', body: 'fed by TrendsModel; each week on the season shelf is a WaterThumbnail rendered by the same shader. The projection stays dashed, so projected weeks are never drawn in the solid ink of the ones already measured.' },
        ],
      },
      {
        kind: 'note', label: 'ORIGIN', title: 'It started as a shader, not an app.',
        body: 'The first build was Refraction Pixels, an Uno Platform desktop sample written to test SkiaSharp 4.148’s runtime SkSL through SKCanvasElement. Watching the caustics run, the question changed from “can the canvas do this” to “what product deserves this water.” That answer is Poolside.',
        rows: ['refraction pixels', 'skiasharp 4.148', 'runtime sksl'],
        video: { src: '/videos/water-shader.mp4', cap: 'The water shader, live', sub: 'Uno Platform · SkiaSharp 4.148' },
      },
      {
        /* the exploded layer stack, exactly as on the exhibit (pl-deck + legend) */
        kind: 'stack', label: 'STAGES', title: 'Four stages, one pass.',
        body: 'The figures are not diagrams: each layer runs its isolated stage in WebGL, in this site’s inks — stacked as the layers they are, composited in a single pass.',
        items: [
          { no: 'fig.04 · field', title: 'Value noise → fbm', body: 'A hashed lattice smoothed with a cubic fade, then four octaves summed. Everything organic in the shader (surface wobble, caustic warp, murk) is drawn from this field.' },
          { no: 'fig.05 · warp', title: 'Directional wave warp', body: 'Three sine waves at odd angles with incommensurate frequencies displace the sampling position, so nothing ever lines up with the grid. Gray is the undisturbed grid; ink is what the water does to it.' },
          { no: 'fig.06 · caustic', title: 'Caustic web', body: 'Warped-sine interference, rotated off-grid and bent by slow value noise. A sixth-power falloff pinches the bright bands into filaments; a third rotated layer breaks the remaining symmetry.' },
          { no: 'fig.07 · water · own inks', title: 'Composite · Poolside’s water', body: 'Depth tint, caustics scaled by clarity, spec highlights from the noise gradient, and sparkle on the filament cores. The app runs exactly this.' },
        ],
      },
    ],
    iters: [],
    post: [
      {
        kind: 'note', label: 'ONE PASS', title: 'In the app.',
        body: 'In the app the stages are not four passes: they are one half4 main(float2 fragCoord) SkSL program, compiled once into an SKRuntimeEffect and drawn by a single SKCanvasElement. field, warp, and caustic are helper functions feeding the composite, so the whole stack resolves per pixel in a single pass. The builder is cached once, uniforms are snapshotted to plain fields, and the render loop rides CompositionTarget.Rendering.',
        rows: ['skruntimeeffect', 'one pass', 'vsync'],
      },
      {
        kind: 'code', label: 'CODE', title: 'Key passages · PoolWater.sksl',
        body: 'The exact passages behind the dispersion and the caustic web, as they run in the app.',
      },
      {
        kind: 'parts', label: 'NOTES', title: 'Field notes',
        items: [
          { no: '01', title: 'One warp, three channels', body: 'The displacement is linear in its scale, so s(k) = suv + k·disp derives the red and blue samples exactly from the green evaluation.', read: 'disp ±0.06 · dispersion for free' },
          { no: '02', title: 'Cache the builder', body: 'SKRuntimeShaderBuilder is created once and reused. Disposing it per frame frees native state shared with the effect, and the next render access-violates.', read: 'build once · feed uniforms' },
          { no: '03', title: 'Zero-alloc loop', body: 'The render loop rides CompositionTarget.Rendering, snapshots inputs to plain fields, and reuses uniform buffers. At 0% intensity it stops painting.', read: 'vsync · idle at 0%' },
          { no: '04', title: 'GLSL to SkSL', body: 'No varyings, no gl_FragColor. Return a half4 from main(float2 fragCoord). Coordinates arrive in element DIPs, Y down; normalize and flip yourself.', read: 'half4 · Y-down DIPs' },
        ],
      },
    ],
  },
  {
    /* paper world: PaperNotes is a ruled sheet, so its world is the stock
       it prints on — warm paper, graphite ink, the red of its comments */
    slug: 'papernotes', name: 'PAPERNOTES', tag: 'UNO PLATFORM · RULED TYPE · IME',
    deep: '#E7E5DE', accent: '#A33A2A', ink: '#2A2A28', base: '#F1F0EB',
    meta: 'ONE SHEET · SIX PASSES',
    lede: 'A note taken as a ruled sheet rather than a text field. Every line is numbered, indentation reads as elevation, and the rules stay under the words while you write — which turned out to be the hard part.',
    facts: [
      'Uno Platform · net10.0 · desktop + Android',
      'Martian Mono / Newsreader · Skia weight manifests',
      'JSON NoteStore · debounced autosave · .bak recovery',
      'Tests 23/23 · 0 warnings',
    ],
    pre: [
      {
        kind: 'note', label: 'SHEET', title: 'Indentation as elevation.',
        body: 'The sheet is the interface: a 28px ruled grid, numbers in the gutter baseline-aligned at 9px, keyword weights swapped per row between display and edit. Comments set in red Newsreader italic, so an aside looks like an aside. Nothing here is a text box wearing a costume — the rules are a Skia layer under a Perlin grain, and the type sits on them.',
        rows: ['28px grid', 'martian mono', 'newsreader', 'skia rules'],
      },
      {
        kind: 'note', label: 'CARET', title: 'The caret ignores your line height.',
        body: 'On the Uno Skia text stack the caret is drawn from natural font metrics and ignores any LineHeight stamped on the internal text view. A 17px caret sat at the top of a 34px box, misaligned with its own glyphs, and grew 17→34 on the first keystroke. The fix was not markup: MartianMono-Sheet.ttf is the same face with its vertical metrics patched — ascent 1750, descent −250 at upm 1000, typo, hhea and win all aligned — so the natural line box IS the ruled grid and the baseline sits low on the rule.',
        rows: ['fonttools', 'ascent 1750', 'descent −250', 'use_typo_metrics'],
      },
    ],
    iters: [],
    post: [
      {
        kind: 'note', label: 'IME', title: 'Per-row editing lost to the keyboard.',
        body: 'Editing each line as its own TextBox is unworkable against the Android IME, in three verified ways: soft keyboards never deliver Enter or backspace-at-position-0 as KeyDown; a zero-width sentinel with a SelectionChanged guard scrambles batch commits, landing text reversed; and any per-keystroke managed read of TextBox.Text during composition races the native-to-managed sync and reorders fast input. Mobile now hands the whole sheet to one native multiline TextBox and parses on commit — signalled by InputPane.Hiding, because window-resize heuristics never fire.',
        rows: ['unified editing', 'inputpane.hiding', 'parse on commit'],
      },
      {
        kind: 'parts', label: 'NOTES', title: 'Field notes',
        items: [
          { no: '01', title: 'Let the IME own the text', body: 'Every attempt to supervise composition per keystroke corrupted it. The keyboard wins; read the result once, when it is done.', read: 'commit, not keystroke' },
          { no: '02', title: 'Patch the font, not the layout', body: 'When the caret follows natural metrics and nothing else, the metrics are the layout. Retuning the face beat fighting the text view.', read: 'metrics are layout' },
          { no: '03', title: 'Lazy content views measure at zero', body: "Uno's TextBox content view is created on the first layout pass after it becomes visible, and starts unmeasured — a collapsed-then-shown box renders its text invisible until something re-measures.", read: 'stamp from LayoutUpdated' },
          { no: '04', title: 'Fractional DPI drifts the grid', body: 'UseLayoutRounding pushed rows off the rule at non-integer scale factors. Turning it off put the numbers back on their lines.', read: 'UseLayoutRounding=false' },
        ],
      },
    ],
  },
  {
    /* dark world: Light is an ambient surface, so its world is the room it
       sits in — the panel is the only thing giving off light */
    slug: 'lightwidget', name: 'LIGHT', tag: 'AMBIENT · SOLAR MODEL · SKIASHARP',
    deep: '#2B2E44', accent: '#E8A184', ink: '#F2EDE6', base: '#15161F',
    meta: 'FIVE FRAMES · ONE SURFACE',
    lede: 'An ambient clock that reports the time as a quality of light instead of a number to be read. The centre form is the sun, not a dial: where it sits on the arc decides which way the light spreads, which way the surface falls into shadow, how warm it runs, and how bright the panel reads.',
    facts: [
      'Uno Platform · net10.0-desktop · SkiaSharp',
      'Solar model · latitude / longitude / time zone',
      'Not one tappable element',
      'After the "Light" concept by Naoto Fukasawa',
    ],
    pre: [
      {
        kind: 'figure', label: 'OBJECT', title: 'A panel, not a screen.',
        body: 'It is meant to be looked at rather than used, so it is built as an object first: a square face with a generous radius, a soft ground shadow, and a surface that carries light the way a sheet of glass over paper would. Nothing on it is chrome.',
        fig: { src: '/projects/light-object.webp', cap: 'The widget entire', sub: 'Uno Platform · net10.0-desktop · SkiaSharp', ratio: 1.523 },
      },
      {
        kind: 'figure', label: '05:21', title: 'Half an hour after sunrise.',
        body: 'The sun has just cleared 4:51 and sits low on the left of the arc. The panel runs warm cream, the disc burns orange, and the reading underneath is thirteen hours and twenty-one minutes of daylight left. You are not meant to read that line — you are meant to have absorbed it before you get there.',
        fig: { src: '/projects/light-0521.webp', cap: 'Tokyo · 05:21 · sunrise', sub: '13h 21m left · highest at 11:47', ratio: 1.051 },
      },
      {
        kind: 'figure', label: '16:20', title: 'The same day, eleven hours later.',
        body: 'Same city, same date, same surface. The sun has crossed to the right of the arc and the whole panel has cooled out of cream into blue and lilac, with the warmth pushed into the corner the light now comes from. Two hours and twenty-two minutes left. This pair is the entire argument: the time is legible as a temperature before it is legible as a number.',
        fig: { src: '/projects/light-1620.webp', cap: 'Tokyo · 16:20 · late afternoon', sub: '2h 22m left · sunset 18:42', ratio: 1.0 },
      },
      {
        kind: 'figure', label: 'DETAIL', title: 'The corner.',
        body: 'Close in, the disc is a soft body of light rather than a dot with a glow behind it, and the arc it rides is a hairline that never announces itself. The radius is large enough that the face reads as a slab.',
        fig: { src: '/projects/light-corner.webp', cap: 'Radius, arc, and the disc at 4:51', sub: 'detail crop', ratio: 0.969 },
      },
      {
        kind: 'figure', label: 'CITIES', title: 'Tokyo, New York, London.',
        body: 'One model, three coordinates, one moment. Tokyo at 09:22 runs cream and open. New York at 20:22 is past sunset, the panel gone coral into violet. London at 01:22 is night: the beam collapses to nothing, the disc reads as a moon, and the footer counts to sunrise instead of away from it.',
        fig: { src: '/projects/lightwidget-cities.webp', cap: 'Three cities, one surface', sub: 'daylight · dusk · night', ratio: 1.448 },
      },
      {
        kind: 'note', label: 'RESTRAINT', title: 'There is nothing to press.',
        body: 'Interaction of any kind is out of scope, and adding one would break it. State changes come from the clock and the sun, never from the user — so the surface has no affordances to design, only a condition to report. The numeric time is present and deliberately demoted by weight rather than by size.',
        rows: ['no controls', 'terminal surface', 'weight, not size'],
      },
    ],
    iters: [],
    post: [
      {
        kind: 'parts', label: 'NOTES', title: 'Field notes',
        items: [
          { no: '01', title: 'The canvas does ride a scale', body: 'A Viewbox wrapping a fixed-size grid scales an SKCanvasElement and XAML text together and keeps them pixel-registered. Design at literal spec coordinates and let the Viewbox size the surface.', read: 'viewbox · uniform' },
          { no: '02', title: 'CharacterSpacing does nothing here', body: 'On the Skia text stack, 120 units at 72.5px moved the measured ink width by zero pixels — silently, with no analyzer warning. Letterspaced display type is laid out one character per TextBlock in a spaced StackPanel.', read: '0px at 0.12em' },
          { no: '03', title: 'Do not resize the window', body: 'AppWindow.Resize grows the frame before the Skia surface follows, so the app lays out to the new size against the old surface and renders clipped. Pin the content instead and let the window be whatever it is.', read: 'pin content, not frame' },
          { no: '04', title: 'Sigmas stay in design units', body: 'The renderer receives the unscaled design size, so blur radii and stroke widths are written at their real numbers and never carry manual DPI maths.', read: 'no DPI arithmetic' },
        ],
      },
    ],
  },
];

/* client copy of the data — palette, copy, and route per project */
const SHOWN = PROJECTS.filter((p) => !p.hidden);
const CLIENT_PROJECTS = SHOWN.map(({ slug, name, tag, href, linkLabel, deep, accent, ink, base, iters, pre, post, question, meta, lede, facts }) => ({
  slug, name, tag, href, linkLabel, deep, accent, ink, base, iters, pre, post, question, meta, lede, facts,
}));

/* the index: one row per work with a world to walk into. Cleared to Poolside
   alone on 2026-08-04; a project joins this list once its world is built. */
const INDEX_ROWS = [
  /* M. is the year for every row, so the column reads as one thing. The
     descriptor lines (4 STAGES - ONE PASS) still head each detail world. */
  ...SHOWN.map((p) => ({
    name: p.name, tag: p.tag, meta: '2026',
    href: `#/p/${p.slug}`, slug: p.slug, preview: true,
  })),
].map((r, i) => ({ ...r, no: String(i + 1).padStart(3, '0') }));
---
<Bare
  title="Index"
  description="Matt Mattei's public notebook: ideas, experiments, sketches, software, and lessons at the intersection of design and development.">

<NameIntro />

<!-- ---- the hero: one work at a distance ----
     The page opens with the mark docked centre-top and a single centred
     frame — the featured work, live — that expands as the page scrolls
     until it IS the first project, full bleed, and the relay takes over.
     The head copy stands top-left and yields to the approach. -->
<section class="hero" id="hero" style="--hp:0; --ha:0">
  <div class="hero-stick">
    <div class="hero-copy">
      <h1 class="hero-h">SOME TAKE SHAPE.<br>SOME SIMPLY REMAIN IDEAS.</h1>
    </div>
    <a class="hero-photo" href="#/p/poolside" aria-label="Enter Poolside">
      <span class="rl-visual">
        <img class="hero-img" src="/landing/favalanciata.webp" width="1538" height="1023"
             alt="" decoding="async" fetchpriority="high" />
      </span>
    </a>
    <div class="hero-meta" aria-hidden="true">
      <span>SELECTED WORK 01</span><span>Favalanciata · anaglyph engraving</span><span>2026</span>
    </div>
    <div class="hero-cue" aria-hidden="true"><i></i>SCROLL TO ENTER</div>
  </div>
</section>

<!-- ---- the relay: the landing's main navigation ----
     Each featured project holds the full frame, recedes to reveal its title,
     and hands the stage to the next — scroll carries the handoff. The hero
     expands into the first card, and the last card closes onto the index,
     which keeps its dock and its previewer as the fast path. Clicking any
     card walks into that project's world, same as the ledger rows. -->
<div id="heroRise">
  {SHOWN.map((p, i) => {
    const next = SHOWN[i + 1];
    const no = String(i + 1).padStart(2, '0');
    const nextNo = String(i + 2).padStart(2, '0');
    return (
      <section class:list={['rly', { last: !next }]} id={`rly-${p.slug}`} data-slug={p.slug} style={`--rl-accent:${p.accent}`}>
        <div class="rl-stick">
          <div class="rl-topline" aria-hidden="true">
            <span>{no} / {p.name}</span>
            <span>{next ? 'SCROLL — THE NEXT WORK ARRIVES' : 'SCROLL — THE CLOSING ARRIVES'}</span>
          </div>
          <a class="rl-cur" href={`#/p/${p.slug}`} aria-label={`Step into ${p.name}`}>
            {/* every card carries that work's poster, and every poster is
                the same 1100x1556 sheet on the same stock — so the cards
                pose identically and the walk reads even. */}
            <span class="rl-visual">
              <span class="rl-fill rl-sheet">
                <img class="rl-shot" src={`/projects/${p.slug}-poster.webp`}
                     width="1100" height="1556" alt={`${p.name} — poster`}
                     decoding="async" loading={i === 0 ? 'eager' : 'lazy'} />
              </span>
            </span>
          </a>
          <div class="rl-label">
            <div class="rl-no">{no} / {p.tag}</div>
            <h2 class="rl-name">{p.name}</h2>
            {p.lede && <p class="rl-lede">{p.lede}</p>}
            <a class="rl-enter" href={`#/p/${p.slug}`}>STEP INSIDE <span aria-hidden="true">↗</span></a>
          </div>
          <div class="rl-handline" aria-hidden="true"></div>
          <div class="rl-handlbl" aria-hidden="true">{next ? `NEXT · ${nextNo} ${next.name}` : 'NEXT · THE CLOSING'}</div>
          {/* the hand-off: the next card rises behind this one. With one work
              on the board there is nothing to hand to, so both the rising card
              and its title stay out of the DOM until a second world exists. */}
          {next && (
            <a class="rl-next" href={`#/p/${next.slug}`} tabindex="-1" aria-hidden="true"
               style={`--rl-next-ink:${RELAY_ART_INK[next.slug] || '#F6F2EE'}`}>
              <span class="rl-visual">
                <span class="rl-fill rl-sheet">
                  <img class="rl-shot" src={`/projects/${next.slug}-poster.webp`}
                       width="1100" height="1556" alt="" decoding="async" loading="lazy" />
                </span>
              </span>
            </a>
          )}
          {next && (
            <div class="rl-next-title" aria-hidden="true" style={`color:${RELAY_ART_INK[next.slug] || '#F6F2EE'}`}>
              <span>{nextNo} / {next.tag}</span>
              <b>{next.name}</b>
            </div>
          )}
        </div>
      </section>
    );
  })}
</div>

<!-- ---- the closing: end of the sequence ----
     The landing ends here — the full ledger lives in the index overlay
     (masthead, top right), and the featured five are one click away. -->
<section class="closing">
  <div>
    <div class="cl-kicker">END OF SELECTED SEQUENCE</div>
    <h2 class="cl-h">BROWSE SLOWLY.<br>JUMP QUICKLY.</h2>
    <p class="cl-intro">The relay is the default walk. The index holds everything — open it from the masthead, or step straight into a work below.</p>
    <div class="cl-list">
      {SHOWN.map((p, i) => (
        <a class="cl-link" href={`#/p/${p.slug}`}>
          <span>{String(i + 1).padStart(2, '0')}</span>
          <strong>{p.name}</strong>
          <span>{p.tag}</span>
        </a>
      ))}
      <a class="cl-link cl-all" href="/program/">
        <span aria-hidden="true">→</span>
        <strong>VIEW ALL WORK</strong>
        <span>PROGRAM</span>
      </a>
    </div>
  </div>
  <aside class="cl-aside">
    <p>Each work takes a full visual moment, recedes to its title, and hands the frame to the next. Nothing here is a grid.</p>
    <button class="cl-replay" id="replay" type="button">REPLAY SEQUENCE</button>
  </aside>
</section>

<!-- ---- the index: the ledger, as an overlay view ----
     The same rows and the same previewer as ever — the split reads
     ledger-left, preview-right; the preview pane is the fixed .ppv,
     lit while the panel is open. -->
<div class="index-panel" id="indexPanel" role="dialog" aria-modal="true" aria-label="Project index" aria-hidden="true">
  <button class="index-close" id="indexClose" type="button">CLOSE</button>
  <div class="index-left">
    <div>
      <div class="cl-kicker">PROJECT INDEX / 2026</div>
      <h2 class="ip-h">SELECTED<br>WORK.</h2>
    <div class="pindex" id="pindex">
      <div class="prow phdr" aria-hidden="true">
        <span class="pno">N.</span><span class="pname">P.</span><span class="ptag">T.</span><span class="pmeta">M.</span>
      </div>
      {INDEX_ROWS.map((r, i) => (
        r.href ? (
          <a
            class:list={['prow', { selected: i === 0, listed: !r.preview }]}
            href={r.href} data-slug={r.slug} data-i={r.preview ? i : null}
            style={`--i:${i}`} data-n={i} aria-label={r.name}
          >
            <span class="pno">{r.no}</span>
            <span class="pname">{r.name}</span>
            <span class="ptag">{r.tag}</span>
            <span class="pmeta">{r.meta}</span>
          </a>
        ) : null
      ))}
    </div>
    </div>
    <div class="ip-nav">
      <a href="/program/">PROGRAM</a>
      <a href="/contact/">CONTACT</a>
    </div>
  </div>
  <div class="index-preview" aria-hidden="true">
    <div class="index-hint">HOVER TO PREVIEW · SELECT TO ENTER</div>
  </div>
</div>

<!-- the billboard's holder: the live element parks here on the landing and
     rides into a project's poster slot when a world is entered -->
<div id="tvHold" hidden>
