<style is:global>
/* the landing draws with the site's tokens; type is BigShoulders (display),
   Instrument Sans (body, via global.css), IBM Plex Mono (ticks + numerals) */
@font-face {
  font-family: 'BigShoulders';
  font-style: normal;
  font-weight: 800;
  font-display: swap;
  src: url('/fonts/big-shoulders-800.woff2') format('woff2');
}

html, body { overflow-x: clip; }
/* type metrics; the ground itself comes from global.css. Astro leaves body
   selectors unscoped, so a background here would silently override it. */
body { font-size: 16px; line-height: normal; }
#detail h2, #detail p { margin: 0; }



/* ---- masthead: the single header - the index at right, the mark holding
   the centre. Press scale 0.96, the web press. ---- */
.masthead {
  position: fixed; z-index: 8; left: 0; right: 0; top: 0;
  display: flex; justify-content: flex-end; align-items: center;
  padding: 14px 20px; pointer-events: none;
  color: var(--ink);
  transition-property: opacity, color; transition-duration: .2s, .25s; transition-timing-function: ease-out;
}
/* the shell's grid, kept as one line: the 66px top-bar band the mark docks
   into. The old side column is gone - the belt runs the full width now, and
   a rule down the left would cut every sheet that passes it. */
.frame {
  --frame: 66px;
  position: fixed; inset: 0; z-index: 7; pointer-events: none;
  transition: opacity .2s ease-out;
}
.frame::after {
  content: ''; position: absolute; left: 0; right: 0; top: 0; height: var(--frame);
  background: rgba(246, 242, 238, .55); border-bottom: var(--bw) solid var(--line);
}
body.walked .frame { opacity: 0; }
.mh-index {
  pointer-events: auto; border: 0; background: transparent; cursor: pointer;
  font-family: var(--sans); font-size: 10px; font-weight: 600; letter-spacing: 1.8px;
  color: inherit; text-decoration: none; padding: 13px 10px;
  transition-property: opacity, transform; transition-duration: .15s, .12s; transition-timing-function: ease-out;
}
.mh-index:hover { opacity: .65; }
.mh-index:active { transform: scale(.96); }
body.walked .masthead { opacity: 0; pointer-events: none; }

.cl-kicker { font-size: 10px; font-weight: 600; letter-spacing: 1.8px; color: var(--muted); }

/* ---- the belt ----
   The landing is one surface: a fixed canvas the engine draws every sheet
   into, and a layer of anchors above it that carry the links. Nothing here
   scrolls; the belt is the only thing that moves. */
html, body { height: 100%; overflow: hidden; }
.belt {
  position: fixed; inset: 0; z-index: 1;
  cursor: grab; touch-action: none;
  transition: opacity .3s ease-out;
}
.belt.grabbing { cursor: grabbing; }
.belt.locked { pointer-events: none; }
.belt-gl { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
/* the anchors: the engine writes translate + scale on a 100x100 box, so a
   pose costs one composited transform and never a layout pass */
.belt-hit { position: absolute; inset: 0; z-index: 2; }
.pst {
  position: absolute; left: 0; top: 0; width: 100px; height: 100px;
  transform-origin: 0 0; display: block; text-decoration: none;
  will-change: transform;
}
.pst-img { width: 100%; height: 100%; object-fit: fill; display: block; }
/* WebGL draws the sheets; the img is only the fallback, and only then */
.belt-hit.gl .pst-img { opacity: 0; }
.pst:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
/* before the engine runs (and with no script at all) the anchors read as a
   plain horizontal shelf, so the work is still there to be opened */
.belt-hit:not(.ready) {
  display: flex; align-items: center; gap: 3vw; overflow-x: auto;
  padding: 0 6vw; inset: 12vh 0 12vh;
}
.belt-hit:not(.ready) .pst { position: static; flex: none; width: auto; height: 62vh; transform: none; }
.belt-hit:not(.ready) .pst-img { width: auto; height: 100%; object-fit: contain; }

/* the threshold: two ticks on the centre line, and nothing else */
.thr {
  position: absolute; z-index: 3; left: 50%; top: 0; bottom: 0; width: 1px;
  transform: translateX(-50%); pointer-events: none;
  display: flex; flex-direction: column; justify-content: space-between;
  padding: 13vh 0 12vh;
  transition: opacity .3s ease-out;
}
.thr i { display: block; width: 1px; height: 26px; background: var(--line-2); }

/* the readout: the sheet standing in the centre, named. Swaps as the belt
   hands the threshold from one work to the next. */
.now {
  position: absolute; z-index: 3; left: 50%; bottom: 7.4vh;
  transform: translateX(-50%); width: min(560px, 84vw);
  text-align: center; pointer-events: none;
  transition: opacity .18s ease-out, transform .34s cubic-bezier(.22, 1, .36, 1);
}
.now.swap { opacity: 0; transform: translateX(-50%) translateY(7px); }
.now-line {
  display: flex; justify-content: center; gap: 14px; align-items: baseline;
  font-family: var(--mono); font-size: 10px; letter-spacing: 1.8px; color: var(--muted);
  font-variant-numeric: tabular-nums lining-nums;
}
.now-name {
  margin: 9px 0 0; font-family: 'BigShoulders', sans-serif; font-weight: 800;
  font-size: clamp(34px, 3.6vw, 58px); line-height: .94; letter-spacing: 0;
  -webkit-text-stroke: 1.2px var(--ink); color: var(--ink);
}
.now-tag { margin-top: 7px; font-size: 10px; font-weight: 600; letter-spacing: 1.6px; color: var(--muted); }

.belt-cue {
  position: absolute; z-index: 3; right: max(18px, 3.8vw); bottom: 30px;
  display: flex; align-items: center; gap: 10px; pointer-events: none;
  font-size: 10px; font-weight: 600; letter-spacing: 1.8px; color: var(--muted);
  transition: opacity .3s ease-out;
}
.belt-cue i { width: 30px; height: 1.5px; background: currentColor; transform-origin: right; animation: beltPulse 2.4s cubic-bezier(.22, 1, .36, 1) infinite; }
@keyframes beltPulse { 0%, 100% { transform: scaleX(.2); opacity: .3; } 45% { transform: scaleX(1); opacity: .9; } }

/* the index takes the centre readout and the cue off the stage */
body.index-open .now, body.index-open .belt-cue, body.index-open .thr { opacity: 0; }
body.walked .belt, body.entering .now, body.entering .belt-cue, body.entering .thr { opacity: 0; }
body.walked .belt { pointer-events: none; }

/* ---- the index: ledger left, the stack (drawn by the engine) at right ----
   The panel is only the left half; the sheets on the right are the same
   canvas that was carrying the belt a moment ago. */
.ix {
  position: fixed; z-index: 6; left: 0; top: 0; bottom: 0;
  width: min(52vw, 720px);
  opacity: 0; visibility: hidden; pointer-events: none;
  transition-property: opacity, visibility, transform;
  transition-duration: .3s; transition-timing-function: ease-out;
  transform: translateX(-14px);
}
body.index-open .ix { opacity: 1; visibility: visible; pointer-events: auto; transform: none; }
body.entering .ix { opacity: 0; }
.ix-left {
  height: 100%; padding: 12vh 3.2vw 5vh 4.6vw; overflow-y: auto;
  display: flex; flex-direction: column; justify-content: space-between; gap: 40px;
}
.ix-foot { flex: none; }
/* the supporting line: it answers the row under the pointer, and sits with
   the ledger rather than at the foot, so the two read as one column */
.ix-note {
  margin: 30px 0 0; min-height: 3.4em; max-width: 420px; padding-left: 4px;
  font-size: 13.5px; line-height: 1.62; color: var(--muted); text-wrap: pretty;
  transition: opacity .16s ease-out;
}
.ix-note.swap { opacity: 0; }
.ip-nav { display: flex; gap: 26px; }
.ip-nav a {
  font-size: 10px; font-weight: 600; letter-spacing: 1.8px; color: var(--muted); text-decoration: none;
  transition-property: color; transition-duration: .15s; transition-timing-function: ease-out;
}
.ip-nav a:hover { color: var(--ink); }
/* under the ledger, a wash: at rest the stack stands clear of it, but every
   sheet crosses this ground on its way there, and the type has to hold */
.ix::before {
  content: ''; position: absolute; inset: 0; z-index: -1;
  background: linear-gradient(90deg, rgba(248, 247, 243, .985) 0 76%, rgba(248, 247, 243, 0));
}

@media (max-width: 900px) {
  .ix { width: 100vw; }
  .ix::before { background: linear-gradient(180deg, rgba(248, 247, 243, .97) 0 68%, rgba(248, 247, 243, .74)); }
  .ix-left { padding: 12vh 20px 5vh; }
  .now-name { font-size: clamp(26px, 7vw, 40px); }
  .belt-cue { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  .belt-cue i { animation: none; }
  .now, .ix, .ix-note { transition-duration: .01ms; }
}


/* ---- shelf + billboard ---- */
.tv {
  position: absolute; left: 342px; top: 161px; width: 944px; height: 452px;
  border-radius: 55px; padding: 5px; cursor: pointer;
  background: linear-gradient(180deg, #E7E1DB 0%, #EEE9E4 55%, #F3F0EB 100%);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.55),
    0 0 0 1px rgba(70,62,54,.10),
    0 14px 22px -10px rgba(70,58,46,.26),
    30px 22px 44px -16px rgba(88,76,64,.42),
    0 34px 54px -26px rgba(70,58,46,.20);
}
.tv .screen {
  position: relative; width: 934px; height: 442px; border-radius: 50px;
  overflow: hidden; background: var(--ink);
  box-shadow: inset 0 0 0 1px rgba(10,9,8,.92);
  transition-property: transform; transition-duration: .2s; transition-timing-function: ease-out;
}
/* the permanent hero: the window-at-dusk loop, in colour. object-fit cover
   fills the 934x442 screen; the source is already cropped to that aspect so
   there is almost nothing to trim. */
.bb-hero {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; display: block; z-index: 0;
  /* black-and-white by filter, so the colour source stays intact and this is
     one line to drop. contrast/brightness recover the range grayscale flattens. */
  filter: grayscale(1) contrast(1.08) brightness(1.04);
}
.tv .art {
  display: none;
  position: absolute; inset: 0;
  opacity: 0; transform: scale(1.02);
  transition: opacity .32s cubic-bezier(.22,1,.36,1), transform .32s cubic-bezier(.22,1,.36,1);
}
.tv .art.on { opacity: 1; transform: none; }

/* (the hero, the relay and the hover previewer lived here; the belt replaced
   all three, and its rules sit with the masthead above) */


/* ---- the ledger: the index's rows ----
   Hover answers twice — in the note under the list, and by fronting that
   work's sheet in the stack at right. Four columns and no more: the ledger
   is a contents page, not a file browser. */
.pindex { position: relative; margin-top: 34px; width: 100%; max-width: 1000px; }
.prow {
  position: relative; display: grid; align-items: center;
  grid-template-columns: 46px 1fr 168px 62px; gap: 16px;
  height: 34px; padding: 0 0 0 4px;
  font-size: 14px; line-height: 1;
  color: var(--ink); text-decoration: none;
  border-top: 1px solid transparent;
  transition-property: background-color, border-color, padding-left, opacity;
  transition-duration: .15s, .15s, .22s, .2s;
  transition-timing-function: cubic-bezier(.22,1,.36,1);
}
/* the prototype's two motions: the row under the pointer steps right, and
   everything else recedes so the list reads as one live line */
.pindex:hover .prow:not(.phdr):not(:hover) { opacity: .34; }
.prow:hover, .prow:focus-visible { padding-left: 12px; }
.prow:hover, .prow:focus-visible, .prow.selected {
  outline: none;
  background: rgba(255,255,255,.62);
  border-top-color: var(--accent);
  box-shadow: 0 1px 0 rgba(26,24,21,.14);
}
.prow:hover .pname, .prow.selected .pname { font-weight: 700; }
/* one staged sequence on load: the header rule, then the rows in order.
   Keyframes rather than transitions because it runs once and is not a
   response to input. 16ms a row - 100ms would take 2.8s across 28 of them. */
@keyframes ledgerIn {
  from { opacity: 0; transform: translateY(5px); }
  to   { opacity: 1; transform: none; }
}
.pindex { animation: ledgerIn .34s cubic-bezier(.22,1,.36,1) both; }
/* rows hold at rest until they are approached: firing all 28 on load meant
   the ~22 below the fold had long settled before anyone scrolled to them */
.prow { opacity: 0; }
/* an unrevealed row is invisible; it must not be hoverable either */
.prow:not(.in) { pointer-events: none; }
.prow.in { opacity: 1; animation: ledgerIn .42s cubic-bezier(.22,1,.36,1) both;
  animation-delay: var(--d, 0ms); }
.phdr {
  opacity: .5; font-size: 11px; letter-spacing: .12em;
  border-top: 0; background: none; pointer-events: none; margin-bottom: 4px;
}
.phdr:hover { background: none; border-top-color: transparent; box-shadow: none; }
.pno { opacity: .6; }
/* body sets oldstyle figures for running text; an index column needs lining
   and tabular ones or 001 / 028 / 2026 sit at different heights and ragged
   widths, and the column stops reading as a column */
.pno, .pmeta { font-variant-numeric: tabular-nums lining-nums; }
.pname { font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pname::after { content: ' ↗'; font-size: .8em; opacity: 0; transition: opacity .18s ease-out; }
.prow:hover .pname::after, .prow:focus-visible .pname::after { opacity: 1; }
.pname { font-size: 15px; }
/* medium and year are the quiet columns: mono, so the four rows line up as
   a set of readings rather than as four sentences */
.ptag, .pmeta {
  opacity: .62; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  font-family: var(--mono); font-size: 10px; letter-spacing: .12em;
}
.pmeta { text-align: right; }
@media (prefers-reduced-motion: reduce) {
  .pindex, .prow.in { animation: none; }
  .prow { opacity: 1; }
  .pindex, .masthead, .prow { transition-duration: .01ms; }
}

/* the IsoBasin construction, now only for the phone cloned into the
   Poolside world (rules reused from /poolside/) */
.b-wall {
  position: absolute; background: linear-gradient(180deg, #e3f0f2, #bcdadf);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.5), inset 0 -8px 12px -8px rgba(0,30,40,.35);
}
.b-wall.n { top: 0; left: 0; width: 100%; height: 22px; transform-origin: top center; transform: rotateX(-90deg); }
.b-wall.s { bottom: 0; left: 0; width: 100%; height: 22px; transform-origin: bottom center; transform: rotateX(90deg); }
.b-wall.w { top: 0; left: 0; width: 22px; height: 100%; transform-origin: left center; transform: rotateY(90deg); }
.b-wall.e { top: 0; right: 0; width: 22px; height: 100%; transform-origin: right center; transform: rotateY(-90deg); }
.b-floor { position: absolute; inset: 0; background: #b3d3d9; transform: translateZ(-22px); }
.b-surf {
  position: absolute; inset: 0; border-radius: 16px; overflow: hidden;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.55), inset 0 -18px 26px -18px rgba(0,20,30,.5), 0 22px 34px -26px rgba(9,80,102,.75);
}
