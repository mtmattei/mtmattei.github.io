<style is:global>
/* the landing draws with the site's tokens; type is BigShoulders (display),
   Instrument Sans (body, via global.css), IBM Plex Mono (ticks + numerals) */
@font-face {
  font-family: 'BigShoulders';
  font-style: normal;
  font-weight: 800;
  font-display: swap;
  src: url('/fonts/big-shoulders-800.woff2') format('woff2');
}

html, body { overflow-x: clip; }
/* type metrics; the ground itself comes from global.css. Astro leaves body
   selectors unscoped, so a background here would silently override it. */
body { font-size: 16px; line-height: normal; }
#detail h2, #detail p { margin: 0; }



/* ---- masthead: the single header - the index at right, the mark holding
   the centre. Press scale 0.96, the web press. ---- */
.masthead {
  position: fixed; z-index: 8; left: 0; right: 0; top: 0;
  display: flex; justify-content: flex-end; align-items: center;
  padding: 14px 20px; pointer-events: none;
  /* ink over paper, paper over a full-bleed card - driven by the same
     relay-live signal as the mark. Difference-blending here forced the
     whole page into one compositing group, repainted on every scroll. */
  color: var(--ink);
  transition-property: opacity, color; transition-duration: .2s, .25s; transition-timing-function: ease-out;
}
body.relay-live .masthead { color: #F6F2EE; }
/* the shell's grid lines: a 66px top-bar row (the masthead's band, the
   mark docked inside it) and the old rail's 34px side-bar column, both
   washed with translucent paper so the frame reads over any card */
/* the shell's grid, kept as lines. Both bands are one measure, so the
   frame reads as an even margin rather than a wide top and a thin side —
   change --frame once and both follow. */
.frame {
  --frame: 66px;
  position: fixed; inset: 0; z-index: 7; pointer-events: none;
  transition: opacity .2s ease-out;
}
.frame::before {
  content: ''; position: absolute; left: 0; top: var(--frame); bottom: 0; width: var(--frame);
  background: rgba(246, 242, 238, .55); border-right: var(--bw) solid var(--line);
}
.frame::after {
  content: ''; position: absolute; left: 0; right: 0; top: 0; height: var(--frame);
  background: rgba(246, 242, 238, .55); border-bottom: var(--bw) solid var(--line);
}
body.walked .frame { opacity: 0; }
@media (max-width: 820px) {
  .frame::before { display: none; }   /* copy hugs the edge here */
}
.mh-index {
  pointer-events: auto; border: 0; background: transparent; cursor: pointer;
  font-family: var(--sans); font-size: 10px; font-weight: 600; letter-spacing: 1.8px;
  color: inherit; text-decoration: none; padding: 13px 10px;
  transition-property: opacity, transform; transition-duration: .15s, .12s; transition-timing-function: ease-out;
}
.mh-index:hover { opacity: .65; }
.mh-index:active { transform: scale(.96); }
body.walked .masthead { opacity: 0; pointer-events: none; }
/* the landing stops painting under an open world (layout height stays,
   so the exit lands back on the same scroll position) */
body.walked .hero, body.walked #heroRise, body.walked .closing { visibility: hidden; }

/* ---- the closing: end of the sequence ---- */
.closing {
  min-height: 100vh; padding: 16vh 4.6vw 12vh;
  display: grid; grid-template-columns: 1.2fr .8fr; gap: 8vw; align-items: start;
}
.cl-kicker { font-size: 10px; font-weight: 600; letter-spacing: 1.8px; color: var(--muted); }
.cl-h {
  margin: 16px 0 0; font-family: 'BigShoulders', sans-serif; font-weight: 800;
  font-size: clamp(52px, 7.4vw, 124px); line-height: .9; letter-spacing: 0;
  -webkit-text-stroke: 1.8px var(--ink); color: var(--ink); text-wrap: balance;
}
.cl-intro { margin: 26px 0 56px; max-width: 440px; font-size: 15px; line-height: 1.7; color: var(--muted); text-wrap: pretty; }
.cl-list { border-top: 1px solid #BCB8B4; }
.cl-link {
  display: grid; grid-template-columns: 46px 1fr auto; gap: 18px; align-items: center;
  padding: 18px 0 18px 4px; border-bottom: 1px solid #DAD5CE;
  color: var(--ink); text-decoration: none;
  transition-property: background-color, padding-left;
  transition-duration: .15s, .22s; transition-timing-function: cubic-bezier(.22, 1, .36, 1);
}
.cl-link:hover { background: rgba(255, 255, 255, .62); padding-left: 14px; }
.cl-link strong { font-family: 'BigShoulders', sans-serif; font-weight: 800; font-size: 26px; letter-spacing: .02em; }
.cl-link span { font-size: 9px; font-weight: 600; letter-spacing: 1.4px; color: var(--muted); font-variant-numeric: tabular-nums lining-nums; }
.cl-all strong { font-family: var(--mono); font-weight: 600; font-size: 13px; letter-spacing: 2px; color: var(--accent); }
.cl-aside { padding-top: 12vh; }
.cl-aside p { margin: 0; max-width: 320px; font-size: 13.5px; line-height: 1.7; color: var(--muted); }
.cl-replay {
  margin-top: 24px; padding: 13px 18px; border: 1px solid rgba(26, 24, 21, .28); border-radius: 999px;
  background: transparent; cursor: pointer;
  font-family: var(--mono); font-size: 10px; font-weight: 600; letter-spacing: 1.8px; color: var(--ink);
  transition-property: background-color, transform; transition-duration: .15s, .12s; transition-timing-function: ease-out;
}
.cl-replay:hover { background: rgba(255, 255, 255, .62); }
.cl-replay:active { transform: scale(.96); }

/* ---- the index overlay: ledger left, previewer right ----
   the split is shared with the fixed .ppv pane - one number, two rules */
:root { --index-split: 53vw; }
.index-panel {
  position: fixed; inset: 0; z-index: 20;
  background: rgba(247, 246, 242, .98);
  display: grid; grid-template-columns: var(--index-split) 1fr;
  opacity: 0; visibility: hidden;
  transition-property: opacity, visibility;
  transition-duration: .35s; transition-timing-function: ease-out;
  overflow: hidden;
}
.index-panel.open { opacity: 1; visibility: visible; }
.index-close {
  position: absolute; right: 20px; top: 14px; z-index: 5;
  border: 0; background: transparent; cursor: pointer; padding: 13px 10px;
  font-family: var(--sans); font-size: 10px; font-weight: 600; letter-spacing: 1.8px; color: var(--ink);
  transition-property: opacity, transform; transition-duration: .15s, .12s; transition-timing-function: ease-out;
}
.index-close:hover { opacity: .65; }
.index-close:active { transform: scale(.96); }
.index-left {
  padding: 9vh 3.2vw 5vh 4.6vw; overflow-y: auto;
  display: flex; flex-direction: column; justify-content: space-between; gap: 40px;
}
.ip-h {
  margin: 14px 0 0; font-family: 'BigShoulders', sans-serif; font-weight: 800;
  font-size: clamp(48px, 6.4vw, 104px); line-height: .9;
  -webkit-text-stroke: 1.8px var(--ink); color: var(--ink);
}
/* the index foot line: the quiet nav under the ledger */
.ip-nav { display: flex; gap: 26px; margin-top: 48px; }
.ip-nav a {
  font-size: 10px; font-weight: 600; letter-spacing: 1.8px; color: var(--muted); text-decoration: none;
  transition-property: color; transition-duration: .15s; transition-timing-function: ease-out;
}
.ip-nav a:hover { color: var(--ink); }
.index-preview { position: relative; background: #E9E4DC; overflow: hidden; }
.index-hint {
  position: absolute; left: 24px; bottom: 20px; z-index: 5;
  font-size: 9px; font-weight: 600; letter-spacing: 1.6px; color: #fff; mix-blend-mode: difference;
}
@media (max-width: 1080px) {
  .index-panel { grid-template-columns: 1fr; }
  .index-preview { display: none; }
}
@media (max-width: 820px) {
  .closing { grid-template-columns: 1fr; padding: 14vh 20px 10vh; }
  .cl-aside { padding-top: 0; }
  .index-left { padding: 12vh 20px 5vh; }
}

/* ---- shelf + billboard ---- */
.tv {
  position: absolute; left: 342px; top: 161px; width: 944px; height: 452px;
  border-radius: 55px; padding: 5px; cursor: pointer;
  background: linear-gradient(180deg, #E7E1DB 0%, #EEE9E4 55%, #F3F0EB 100%);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.55),
    0 0 0 1px rgba(70,62,54,.10),
    0 14px 22px -10px rgba(70,58,46,.26),
    30px 22px 44px -16px rgba(88,76,64,.42),
    0 34px 54px -26px rgba(70,58,46,.20);
}
.tv .screen {
  position: relative; width: 934px; height: 442px; border-radius: 50px;
  overflow: hidden; background: var(--ink);
  box-shadow: inset 0 0 0 1px rgba(10,9,8,.92);
  transition-property: transform; transition-duration: .2s; transition-timing-function: ease-out;
}
/* the permanent hero: the window-at-dusk loop, in colour. object-fit cover
   fills the 934x442 screen; the source is already cropped to that aspect so
   there is almost nothing to trim. */
.bb-hero {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; display: block; z-index: 0;
  /* black-and-white by filter, so the colour source stays intact and this is
     one line to drop. contrast/brightness recover the range grayscale flattens. */
  filter: grayscale(1) contrast(1.08) brightness(1.04);
}
.tv .art {
  display: none;
  position: absolute; inset: 0;
  opacity: 0; transform: scale(1.02);
  transition: opacity .32s cubic-bezier(.22,1,.36,1), transform .32s cubic-bezier(.22,1,.36,1);
}
.tv .art.on { opacity: 1; transform: none; }

/* ---- the hero: the prototype's single centred frame ----
   --hp is raw progress (fades the copy), --ha the eased approach that
   carries the frame from a distance to full bleed. */
.hero { position: relative; height: 230vh; --hp: 0; --ha: 0; }
.hero-stick { position: sticky; top: 0; height: 100vh; overflow: hidden; isolation: isolate; }
.hero-copy {
  /* two set lines, sized to themselves - the card starts low enough that
     the long second line can run past its left edge without meeting it */
  position: absolute; z-index: 6; left: 4.6vw; top: 12vh;
  width: max-content; max-width: 90vw;
  opacity: calc(1 - min(1, var(--hp) * 3.1));
  transform: translateY(calc(var(--hp) * -38px));
  pointer-events: none;
}
.hero-h {
  margin: 0; font-family: 'BigShoulders', sans-serif; font-weight: 800;
  font-size: clamp(40px, 4.6vw, 70px); line-height: .96; letter-spacing: 0;
  -webkit-text-stroke: 1.4px var(--ink); color: var(--ink); text-wrap: balance;
}
.hero-photo {
  position: absolute; z-index: 3; left: 50%; top: calc(61% - var(--ha) * 11%);
  width: calc(58vw + var(--ha) * 42vw); height: calc(43vh + var(--ha) * 57vh);
  transform: translate(-50%, -50%);
  overflow: hidden; display: block; background: #A49275; cursor: pointer;
  contain: layout style paint;
  box-shadow: 0 0 0 1px rgba(0, 0, 0, .08), 0 28px 70px -28px rgba(26, 24, 21, .35);
}
.hero-photo .rl-visual { transform: translate(-50%, -50%) scale(calc(1.05 - var(--ha) * .05)); }
/* the hero still: the anaglyph engraving, covering the constant
   full-viewport layer the card crops. At rest the letterbox holds the
   mountain and the hill town; the rest of the plate opens outward as the
   card grows to full bleed. */
.hero-img {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; display: block;
}
.hero-meta {
  position: absolute; z-index: 5; left: 50%; top: 84.5%; width: 58vw; transform: translateX(-50%);
  display: flex; justify-content: space-between; gap: 24px;
  font-size: 10px; font-weight: 600; letter-spacing: 1.4px; color: var(--muted);
  font-variant-numeric: tabular-nums lining-nums;
  opacity: calc(1 - min(1, var(--hp) * 2.3));
  pointer-events: none;
}
.hero-meta span:nth-child(2) { text-transform: none; letter-spacing: .2px; font-weight: 500; font-size: 11.5px; }
.hero-cue {
  position: absolute; z-index: 5; right: max(18px, 3.8vw); bottom: 30px;
  display: flex; align-items: center; gap: 10px;
  font-size: 10px; font-weight: 600; letter-spacing: 1.8px; color: var(--ink);
  opacity: calc(.78 - min(1, var(--hp) * 2.5));
  pointer-events: none;
}
.hero-cue i { width: 34px; height: 1.5px; background: currentColor; transform-origin: left; animation: heroPulse 1.7s cubic-bezier(.22, 1, .36, 1) infinite; }
@keyframes heroPulse { 0%, 100% { transform: scaleX(.25); opacity: .35; } 50% { transform: scaleX(1); opacity: 1; } }
@media (max-width: 820px) {
  .hero { height: 210vh; }
  .hero-copy { left: 20px; top: 10vh; width: calc(100vw - 40px); max-width: none; }
  .hero-photo { width: calc(86vw + var(--ha) * 14vw); height: calc(40vh + var(--ha) * 60vh); }
  .hero-meta { width: 86vw; }
  .hero-meta span:nth-child(2) { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  .hero { height: 100vh; }
  .hero-stick { position: relative; }
  .hero-cue i { animation: none; }
}

/* ---- the relay: main navigation ----
   Scroll-driven vars written per frame by the relay loop: --p is the recede,
   --hand the handoff hairline, --q the next card's rise. All motion is
   interpolation of the two cards' boxes inside a sticky viewport frame. */
#heroRise { position: relative; }
.rly { position: relative; height: 235vh; --p: 0; --hand: 0; --q: 0; }
.rly.last { height: 175vh; }
.rl-stick { position: sticky; top: 0; height: 100vh; overflow: hidden; isolation: isolate; }
.rl-topline {
  position: absolute; z-index: 6; left: max(18px, 3.8vw); right: max(18px, 3.8vw); top: 24px;
  display: flex; justify-content: space-between; gap: 24px;
  font-size: 10px; font-weight: 600; letter-spacing: 1.8px; color: var(--muted);
  font-variant-numeric: tabular-nums lining-nums;
  opacity: calc(.25 + var(--p) * .75);
  pointer-events: none;
}
.rl-cur, .rl-next {
  position: absolute; display: block; overflow: hidden; text-decoration: none;
  /* the boxes animate layout properties, so keep each card's reflow and
     repaint fenced inside the card (will-change on box props composits
     nothing and only pinned extra layers) */
  contain: layout style paint;
}
.rl-cur {
  left: calc(var(--p) * 7.4%); top: calc(var(--p) * 12%);
  width: calc(100% - var(--p) * 56%); height: calc(100% - var(--p) * 55%);
  z-index: 3; background: #ddd8cf;
  box-shadow: 0 0 0 1px rgba(0, 0, 0, calc(var(--p) * .1)),
              0 24px 60px -22px rgba(26, 24, 21, calc(var(--p) * .3));
}
/* the visual is a constant full-viewport layer; the card is only a clip
   window sliding over it. Sizing content to the animating box relaid out
   an iframe (the labs rebuild their canvases on resize — the flashes),
   a ~2000-glyph pre, and an SVG every scroll frame; at a fixed size the
   subtree lays out once and the box just crops it. */
.rl-visual {
  position: absolute; left: 50%; top: 50%; width: 100vw; height: 100vh;
  display: block; transform-origin: center; transform: translate(-50%, -50%);
}
.rl-cur .rl-visual { transform: translate(-50%, -50%) scale(calc(1 + var(--p) * .025)); filter: saturate(calc(1 - var(--p) * .14)); }
.rl-next .rl-visual { transform: translate(-50%, -50%) scale(calc(1.035 - var(--q) * .035)); }
.rl-visual .plate { width: 100%; height: 100%; display: block; }
/* the shader footage carries a baked matte around the water (content is
   ~73% of the frame width); the scale crops to the water itself */
.rl-vid { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transform: scale(1.55); }
/* Every card carries that work's poster (poster/work-posters.html, stitched
   by scripts/build-poster-heroes.mjs). All three are the same 1100 x 1556
   sheet on the same stock, so the cards letterbox by the same amount and
   the walk reads even — the relay is the navigation, and cards of
   different shapes made it feel wonky. `contain`, because a poster cropped
   to fill is no longer a poster. */
.rl-fill { position: absolute; inset: 0; overflow: hidden; display: block; }
.rl-shot {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: contain; display: block;
}
/* the press stock, so the letterbox reads as the sheet's own margin */
.rl-sheet { background: #E4E0D6; }
.rl-label {
  position: absolute; z-index: 5;
  left: calc(4.6vw + var(--p) * 49vw);
  top: calc(72vh - var(--p) * 44vh);
  width: min(440px, 38vw);
  opacity: var(--p);
  transform: translateY(calc((1 - var(--p)) * 22px));
  pointer-events: none;
}
.rl-no { font-family: var(--mono); font-size: 11px; letter-spacing: 1.6px; color: var(--rl-accent, var(--accent)); }
.rl-name {
  margin: 14px 0 0; font-family: 'BigShoulders', sans-serif; font-weight: 800;
  font-size: clamp(52px, 6.4vw, 104px); line-height: .94; letter-spacing: 0;
  -webkit-text-stroke: 1.6px currentColor; color: var(--ink); text-wrap: balance;
}
.rl-lede { margin: 18px 0 0; font-size: 14.5px; line-height: 1.62; color: var(--muted); max-width: 380px; text-wrap: pretty; }
.rl-enter {
  display: inline-flex; align-items: center; gap: 10px; margin-top: 22px; padding: 10px 0;
  font-family: var(--mono); font-size: 11px; font-weight: 600; letter-spacing: 2px;
  color: var(--rl-accent, var(--accent)); text-decoration: none; pointer-events: auto;
  transition-property: opacity; transition-duration: .15s; transition-timing-function: ease-out;
}
.rl-enter:hover { opacity: .65; }
.rl-handline {
  position: absolute; z-index: 2; left: 7.4%; right: 7.4%; top: 63%; height: 1px;
  background: #BCB8B4; transform: scaleX(var(--hand)); transform-origin: left; opacity: var(--hand);
}
.rl-handlbl {
  position: absolute; z-index: 4; left: 7.4%; top: calc(63% + 13px);
  font-size: 10px; font-weight: 600; letter-spacing: 1.8px; color: var(--muted);
  font-variant-numeric: tabular-nums lining-nums;
  opacity: var(--hand); pointer-events: none;
}
.rl-next {
  left: calc(50% - (42vw - var(--q) * 42vw) / 2);
  top: calc(104% - var(--q) * 104%);
  width: calc(42vw + var(--q) * 58vw);
  height: calc(31vh + var(--q) * 69vh);
  z-index: 8; background: #ddd8cf;
  box-shadow: 0 0 0 1px rgba(0, 0, 0, .08), 0 24px 60px -18px rgba(26, 24, 21, .28);
}
.rl-next-title {
  position: absolute; z-index: 9; left: 5.4vw; bottom: 6.4vh; pointer-events: none;
  opacity: var(--q); transform: translateY(calc((1 - var(--q)) * 22px));
}
.rl-next-title span { display: block; font-size: 10px; font-weight: 600; letter-spacing: 1.8px; opacity: .78; }
.rl-next-title b {
  display: block; margin-top: 12px; font-family: 'BigShoulders', sans-serif; font-weight: 800;
  font-size: clamp(56px, 7.6vw, 128px); line-height: .9; letter-spacing: 0;
  -webkit-text-stroke: 1.6px currentColor;
}
@media (max-width: 820px) {
  .rly { height: 205vh; }
  .rly.last { height: 150vh; }
  .rl-cur { left: calc(var(--p) * 5%); width: calc(100% - var(--p) * 10%); height: calc(100% - var(--p) * 58%); }
  .rl-label { left: 6vw; top: calc(70vh - var(--p) * 22vh); width: 88vw; }
  .rl-lede { max-width: 88vw; }
  .rl-name { font-size: clamp(40px, 10vw, 72px); }
  .rl-handline { top: 66%; }
  .rl-handlbl { top: calc(66% + 13px); }
  .rl-next { left: calc(50% - (84vw - var(--q) * 84vw) / 2); width: calc(84vw + var(--q) * 16vw); height: calc(32vh + var(--q) * 68vh); }
  .rl-next-title { left: 6vw; bottom: 7vh; }
  .rl-next-title b { font-size: clamp(40px, 11vw, 72px); }
}
@media (prefers-reduced-motion: reduce) {
  /* each beat is a still plate: the receded pose with its title, no relay */
  .rly, .rly.last { height: auto; --p: 1; --hand: 1; --q: 0; }
  .rl-stick { position: relative; height: 100vh; }
  .rl-next, .rl-next-title { display: none; }
  .rl-cur .rl-visual { transform: translate(-50%, -50%); filter: none; }
  .idx-jump { transition-duration: .01ms; }
}

/* ---- hover previewer ----
   The index overlay's right pane: fixed over the panel's preview area,
   lit only while the panel is open. Cards stack; the hovered row's card
   cross-fades in - the split reads ledger-left, preview-right. */
.ppv {
  position: fixed; z-index: 21; pointer-events: none;
  left: var(--index-split); right: 0; top: 0; bottom: 0;
  opacity: 0; visibility: hidden;
  transition-property: opacity, visibility;
  transition-duration: .35s; transition-timing-function: ease-out;
}
body.index-open .ppv { opacity: 1; visibility: visible; }
.ppv::after {
  content: 'HOVER TO PREVIEW · SELECT TO ENTER';
  position: absolute; left: 24px; bottom: 20px; z-index: 5;
  font-size: 9px; font-weight: 600; letter-spacing: 1.6px;
  color: #fff; mix-blend-mode: difference;
}
.ppv-card {
  position: absolute; inset: 0; overflow: hidden;
  opacity: 0; transform: translateY(12px) scale(.985);
  /* fast cross-fade: moving down the index should feel like flipping
     through work, not waiting for dissolves */
  transition: opacity .12s ease-out, transform .26s cubic-bezier(.22,1,.36,1);
  box-shadow: 0 18px 45px rgba(15,15,10,.12), 0 0 0 1px rgba(0,0,0,.08);
  background: #ddd8cf;
}
.ppv-card.on { opacity: 1; transform: translateY(0) scale(1); }
.ppv-art { position: absolute; inset: 0; display: block; }
.ppv-art :global(.plate) { width: 100%; height: 100%; display: block; }
.ppv-img, .ppv-vid { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
/* the shader footage carries the recording's chrome around the water;
   the same crop as the relay cards keeps the pane pure water */
.ppv-vid { transform: scale(1.55); }
/* the poster seats whole in the previewer, on the same stock as the cards */
.ppv-sheet { object-fit: contain; background: #E4E0D6; }
.ppv-fill { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.ppv-fill.wordmark {
  background: hsl(var(--hue, 40) 14% 88%);
  font-family: var(--sans); font-weight: 600; font-size: 30px; letter-spacing: -.02em;
  color: rgba(26,24,21,.28); text-align: center; padding: 0 8%; line-height: 1.05;
}
/* name + number, bottom, difference-blended so it reads on any art */
.ppv-info {
  position: absolute; z-index: 3; left: 18px; right: 18px; bottom: 16px;
  display: flex; justify-content: space-between; gap: 16px;
  color: #fff; font-size: 10px; letter-spacing: 1.4px; text-transform: uppercase;
  font-variant-numeric: tabular-nums lining-nums; mix-blend-mode: difference;
}
@media (max-width: 1080px) { .ppv { display: none; } }
@media (prefers-reduced-motion: reduce) { .ppv-card { transition-duration: .01ms; } }

/* ---- the ledger: the index overlay's rows ----
   Hover answers in the previewer pane at right. */
.pindex { position: relative; margin-top: 34px; width: 100%; max-width: 1000px; }
.prow {
  position: relative; display: grid; align-items: center;
  grid-template-columns: 58px 380px 1fr 150px; gap: 16px;
  height: 22px; padding: 0 0 0 4px;
  font-size: 13px; line-height: 1;
  color: var(--ink); text-decoration: none;
  border-top: 1px solid transparent;
  transition-property: background-color, border-color, padding-left, opacity;
  transition-duration: .15s, .15s, .22s, .2s;
  transition-timing-function: cubic-bezier(.22,1,.36,1);
}
/* the prototype's two motions: the row under the pointer steps right, and
   everything else recedes so the list reads as one live line */
.pindex:hover .prow:not(.phdr):not(:hover) { opacity: .34; }
.prow:hover, .prow:focus-visible { padding-left: 12px; }
.prow:hover, .prow:focus-visible, .prow.selected {
  outline: none;
  background: rgba(255,255,255,.62);
  border-top-color: var(--accent);
  box-shadow: 0 1px 0 rgba(26,24,21,.14);
}
.prow:hover .pname, .prow.selected .pname { font-weight: 700; }
/* one staged sequence on load: the header rule, then the rows in order.
   Keyframes rather than transitions because it runs once and is not a
   response to input. 16ms a row - 100ms would take 2.8s across 28 of them. */
@keyframes ledgerIn {
  from { opacity: 0; transform: translateY(5px); }
  to   { opacity: 1; transform: none; }
}
.pindex { animation: ledgerIn .34s cubic-bezier(.22,1,.36,1) both; }
/* rows hold at rest until they are approached: firing all 28 on load meant
   the ~22 below the fold had long settled before anyone scrolled to them */
.prow { opacity: 0; }
/* an unrevealed row is invisible; it must not be hoverable either */
.prow:not(.in) { pointer-events: none; }
.prow.in { opacity: 1; animation: ledgerIn .42s cubic-bezier(.22,1,.36,1) both;
  animation-delay: var(--d, 0ms); }
.phdr {
  opacity: .5; font-size: 11px; letter-spacing: .12em;
  border-top: 0; background: none; pointer-events: none; margin-bottom: 4px;
}
.phdr:hover { background: none; border-top-color: transparent; box-shadow: none; }
.pno { opacity: .6; }
/* body sets oldstyle figures for running text; an index column needs lining
   and tabular ones or 001 / 028 / 2026 sit at different heights and ragged
   widths, and the column stops reading as a column */
.pno, .pmeta { font-variant-numeric: tabular-nums lining-nums; }
.pname { font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pname::after { content: ' ↗'; font-size: .8em; opacity: 0; transition: opacity .18s ease-out; }
.prow:hover .pname::after, .prow:focus-visible .pname::after { opacity: 1; }
.ptag, .pmeta { opacity: .6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* the descriptor is clipped to its column at rest; the row under the pointer
   lets it run over the year and the empty space to its right, on a solid
   ground so it stays legible. The very longest still clip at the row edge -
   the full text lives in the preview card. */
.prow:hover .ptag, .prow:focus-visible .ptag {
  overflow: visible; text-overflow: clip; position: relative; z-index: 2;
  padding-right: 14px; width: max-content; max-width: 760px;
  background: linear-gradient(90deg, #FBFAF7 0 92%, transparent);
}
/* listed only: in the index, nothing to open yet */
.prow.listed { cursor: default; }
.prow.listed .pname { font-weight: 400; }
.prow.listed .pname::after { content: none; }
.prow.listed .ptag:empty::before { content: '—'; opacity: .35; }
@media (prefers-reduced-motion: reduce) {
  .pindex, .prow.in { animation: none; }
  .prow { opacity: 1; }
  .pindex, .masthead, .index-panel, .index-close, .cl-replay, .pfold, .pfold-caret { transition-duration: .01ms; }
}

/* the IsoBasin construction, now only for the phone cloned into the
   Poolside world (rules reused from /poolside/) */
.b-wall {
  position: absolute; background: linear-gradient(180deg, #e3f0f2, #bcdadf);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.5), inset 0 -8px 12px -8px rgba(0,30,40,.35);
}
.b-wall.n { top: 0; left: 0; width: 100%; height: 22px; transform-origin: top center; transform: rotateX(-90deg); }
.b-wall.s { bottom: 0; left: 0; width: 100%; height: 22px; transform-origin: bottom center; transform: rotateX(90deg); }
.b-wall.w { top: 0; left: 0; width: 22px; height: 100%; transform-origin: left center; transform: rotateY(90deg); }
.b-wall.e { top: 0; right: 0; width: 22px; height: 100%; transform-origin: right center; transform: rotateY(-90deg); }
.b-floor { position: absolute; inset: 0; background: #b3d3d9; transform: translateZ(-22px); }
.b-surf {
  position: absolute; inset: 0; border-radius: 16px; overflow: hidden;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.55), inset 0 -18px 26px -18px rgba(0,20,30,.5), 0 22px 34px -26px rgba(9,80,102,.75);
}
.b-surf .plate, .b-surf canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }


/* ---- detail world ---- */
