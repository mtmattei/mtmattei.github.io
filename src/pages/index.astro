      <span class="sheen" aria-hidden="true"></span>
    </div>
  </div>
</div>

<!-- the masthead: the index at right, difference-blended so it reads over
     paper and over the dark cards alike. The mark holds centre. -->
<header class="masthead">
  <button class="mh-index" id="indexOpen" type="button" aria-haspopup="dialog" aria-controls="indexPanel" aria-expanded="false">INDEX</button>
</header>

<!-- the shell's grid, kept as lines: the top bar row and the side bar
     column, hairline-ruled over everything the page scrolls past -->
<div class="frame" aria-hidden="true"></div>

<!-- the Shell's side rail, incorporated: a strip that reveals the nav -->
<!-- the previewer: lifted out of the scaled stage so its size is real px,
     not camera-scaled. A large 4:5 card anchored lower-right that cross-fades
     to the row under the pointer - the prototype's behaviour verbatim. -->
<div class="ppv" id="ppv" aria-hidden="true">
  {INDEX_ROWS.map((r, i) => (
    <div class="ppv-card" data-card={i}>
      <span class="ppv-art">
        {r.slug ? (
          /* the previewer card is 4:5 and the sheet is 0.707, so the poster
             very nearly fills it — same card, same crop, every row */
          <img class="ppv-img ppv-sheet" src={`/projects/${r.slug}-poster.webp`}
               width="1100" height="1556" alt="" decoding="async" loading="lazy" />
        ) : (
          <span class="ppv-fill wordmark" style={`--hue:${(i * 47) % 360}`}>{r.name}</span>
        )}
      </span>
      <span class="ppv-info"><span>{r.name}</span><span>{r.no}</span></span>
    </div>
  ))}
</div>

<div id="detail" role="region" aria-label="Project detail">
  <div class="dcam" id="dcam"><div class="rail" id="rail"></div></div>
  <div class="dchrome">
    <a class="dexit" href="#/" id="dexit"><span class="dexit-arrow"></span>STEP BACK</a>
    <div class="dtimeline" id="dtimeline"></div>
  </div>
</div>

<!-- plates for the detail worlds: cloned into posters when a world is built -->
{SHOWN.map((p) => (
  <template id={`plate-${p.slug}`}><Plate slug={p.slug} /></template>
))}

<!-- the key SkSL passages, highlighted server-side as on /poolside/ -->
<template id="psrc">
